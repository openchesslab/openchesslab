{
    "elixirLS.dialyzerEnabled": true,
    "elixirLS.fetchDeps": true,
    "elixirLS.mixTarget": "host",
    "elixirLS.mixEnv": "test",
    "files.associations": {
        "*.ex": "elixir",
        "*.exs": "elixir",
        "*.heex": "phoenix-heex"
    },
    "[phoenix-heex]": {
        "editor.defaultFormatter": "JakeBecker.elixir-ls",
        "editor.formatOnSave": true
    },
    "[elixir]": {
        "editor.defaultFormatter": "JakeBecker.elixir-ls",
        "editor.formatOnSave": true
    }
}
