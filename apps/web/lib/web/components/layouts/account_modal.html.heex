<div
  id="account-modal"
  class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
>
  <section
    class="max-h-[90dvh] w-full max-w-xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="account-modal-title"
    phx-click-away="close-modal"
  >
    <header class="mb-4 flex items-center justify-between gap-4">
      <h2 id="account-modal-title" class="m-0 text-lg font-semibold">
        {Web.I18n.t("auth.connections", @locale)}
      </h2>

      <button
        type="button"
        class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
        aria-label={Web.I18n.t("common.close", @locale)}
        phx-click="close-modal"
      ><.icon name="close" class="h-4 w-4" /></button>
    </header>

    <p :if={!@current_user} class="text-sm text-muted">
      {Web.I18n.t("auth.loginRequired", @locale)}
    </p>

    <div :if={@current_user}>
      <p class="mb-6 text-sm text-muted">{Web.I18n.t("auth.connectionsHelp", @locale)}</p>
      <p :if={@account_error} id="account-error" role="alert" class="mb-4 text-sm text-error">
        {@account_error}
      </p>
      <ul class="space-y-3">
        <li
          :for={
            {provider, label, enabled} <- [
              {"lichess", "Lichess", @login_enabled},
              {"google", "Google", @google_login_enabled}
            ]
          }
          id={"account-" <> provider}
          class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-panel p-4"
        >
          <div>
            <h3 class="m-0 font-semibold">{label}</h3>
            <p class="text-sm text-muted">
              {Web.I18n.t(
                if(provider in @providers, do: "auth.connected", else: "auth.notConnected"),
                @locale
              )}
            </p>
          </div>
          <button
            :if={provider in @providers}
            type="button"
            id={"unlink-" <> provider}
            phx-click="unlink-provider"
            phx-value-provider={provider}
            class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
          >{Web.I18n.t("auth.unlink", @locale, %{provider: label})}</button>
          <.form
            :if={enabled && provider not in @providers}
            for={%{}}
            id={"link-" <> provider}
            action={~p"/auth/#{provider}/link"}
            method="post"
          >
            <button type="submit" class="rounded-md border border-border px-3 py-2 text-sm">{Web.I18n.t(
              "auth.connect",
              @locale,
              %{provider: label}
            )}</button>
          </.form>
          <p :if={!enabled && provider not in @providers} class="text-sm text-muted">
            {Web.I18n.t("auth.unavailable", @locale)}
          </p>
        </li>
      </ul>
      <p :if={"lichess" not in @providers} id="lichess-unlinked" class="mt-6 text-sm text-muted">
        {Web.I18n.t("auth.lichessUnlinked", @locale)}
      </p>
      <p class="mt-3 text-sm text-muted">{Web.I18n.t("auth.importLater", @locale)}</p>
      <section id="account-danger-zone" class="mt-10 rounded-lg border border-error bg-panel p-4">
        <h3 class="m-0 font-semibold">{Web.I18n.t("auth.deleteHeading", @locale)}</h3>
        <p class="mb-4 mt-1 text-sm text-muted">{Web.I18n.t("auth.deleteHelp", @locale)}</p>
        <.form for={%{}} id="account-delete-form" action={~p"/account/delete"} method="post">
          <label class="mb-2 block text-sm" for="account-delete-confirmation">
            {Web.I18n.t("auth.deleteConfirm", @locale, %{
              word: Web.I18n.t("auth.deleteWord", @locale)
            })}
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <input
              id="account-delete-confirmation"
              name="confirmation"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder={Web.I18n.t("auth.deleteWord", @locale)}
              class="w-44 rounded-md border border-border bg-canvas px-3 py-2 font-mono uppercase"
            />
            <button
              type="submit"
              class="rounded-md border border-error px-3 py-2 text-sm text-error hover:bg-panel-hover"
            >
              {Web.I18n.t("auth.deleteButton", @locale)}
            </button>
          </div>
        </.form>
      </section>
    </div>
  </section>
</div>
