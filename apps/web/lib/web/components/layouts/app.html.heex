<div
  id="app-shell"
  class="min-h-screen bg-canvas text-foreground"
  data-theme={@theme}
  data-room-code={@room_code}
  phx-hook="AppUI"
>
  <a
    href="#main-content"
    class="absolute -top-20 left-3 z-[100] rounded bg-accent px-3 py-2 text-white focus:top-3"
  >{Web.I18n.t("common.skipToContent", @locale)}</a>
  <header class="sticky top-0 z-30 flex min-h-[3.4rem] items-center justify-between gap-3 border-b border-border bg-panel px-4 py-1">
    <.link
      navigate={~p"/"}
      class="flex min-w-0 items-center gap-2 font-semibold tracking-tight text-foreground no-underline"
    >
      <img
        src="/brand/openchesslab-mark-dark.svg"
        alt=""
        class="brand-mark brand-mark-dark h-8 w-8"
      />
      <img
        src="/brand/openchesslab-mark-light.svg"
        alt=""
        class="brand-mark brand-mark-light h-8 w-8"
      /> <span class="hidden sm:inline">OpenChessLab</span>
    </.link>

    <nav
      class="flex items-center gap-1"
      aria-label={Web.I18n.t("common.applicationSettings", @locale)}
    >
      <button
        :if={@room_code}
        type="button"
        class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-transparent bg-transparent px-2 text-foreground hover:border-border hover:bg-panel-hover"
        aria-label={Web.I18n.t("room.importSearchTitle", @locale)}
        title={Web.I18n.t("room.importSearchTitle", @locale)}
        phx-click="open-search"
      >
        <.icon name="search" class="h-4 w-4" />
      </button>

      <form id="piece-set-desktop-form" phx-change="set-piece-set" class="hidden sm:block">
        <label class="sr-only" for="piece-set-desktop">{Web.I18n.t("pieceSet.menu", @locale)}</label>
        <select
          id="piece-set-desktop"
          name="piece_set"
          class="max-w-32 rounded-md border border-border bg-panel px-2 py-2 text-xs text-foreground"
          aria-label={Web.I18n.t("pieceSet.menu", @locale)}
        >
          <option value="merida" selected={@piece_set == "merida"}>Merida</option>

          <option value="cburnett" selected={@piece_set == "cburnett"}>Cburnett</option>
        </select>
      </form>

      <details class="relative sm:hidden">
        <summary
          class="inline-flex min-h-9 min-w-9 cursor-pointer list-none items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("theme.label", @locale)}
          title={Web.I18n.t("theme.label", @locale)}
        >
          <.icon name="settings" class="h-4 w-4" />
        </summary>

        <div class="absolute right-0 top-full z-40 mt-2 flex w-60 flex-col gap-3 rounded-lg border border-border bg-panel p-3 shadow-xl">
          <form id="piece-set-mobile-form" phx-change="set-piece-set">
            <label for="piece-set-mobile" class="flex flex-col gap-1 text-xs text-muted">
              {Web.I18n.t("pieceSet.menu", @locale)}
              <select
                id="piece-set-mobile"
                name="piece_set"
                class="rounded-md border border-border bg-canvas px-2 py-2 text-sm text-foreground"
              >
                <option value="merida" selected={@piece_set == "merida"}>Merida</option>

                <option value="cburnett" selected={@piece_set == "cburnett"}>Cburnett</option>
              </select>
            </label>
          </form>

          <div
            class="flex items-center gap-1"
            role="group"
            aria-label={Web.I18n.t("theme.label", @locale)}
          >
            <button
              type="button"
              class={theme_button(@theme, "system")}
              aria-label={Web.I18n.t("theme.system", @locale)}
              phx-click="set-theme"
              phx-value-theme="system"
            ><.icon name="monitor" class="h-4 w-4" /></button>
            <button
              type="button"
              class={theme_button(@theme, "light")}
              aria-label={Web.I18n.t("theme.light", @locale)}
              phx-click="set-theme"
              phx-value-theme="light"
            ><.icon name="sun" class="h-4 w-4" /></button>
            <button
              type="button"
              class={theme_button(@theme, "dark")}
              aria-label={Web.I18n.t("theme.dark", @locale)}
              phx-click="set-theme"
              phx-value-theme="dark"
            ><.icon name="moon" class="h-4 w-4" /></button>
          </div>

          <button
            type="button"
            class="self-start text-sm text-muted hover:text-foreground"
            phx-click="open-tour"
          >{Web.I18n.t("tour.start", @locale)}</button>
        </div>
      </details>

      <div
        class="hidden items-center gap-0.5 sm:flex"
        role="group"
        aria-label={Web.I18n.t("theme.label", @locale)}
      >
        <button
          type="button"
          class={theme_button(@theme, "system")}
          aria-label={Web.I18n.t("theme.system", @locale)}
          title={Web.I18n.t("theme.system", @locale)}
          phx-click="set-theme"
          phx-value-theme="system"
        ><.icon name="monitor" class="h-4 w-4" /></button>
        <button
          type="button"
          class={theme_button(@theme, "light")}
          aria-label={Web.I18n.t("theme.light", @locale)}
          title={Web.I18n.t("theme.light", @locale)}
          phx-click="set-theme"
          phx-value-theme="light"
        ><.icon name="sun" class="h-4 w-4" /></button>
        <button
          type="button"
          class={theme_button(@theme, "dark")}
          aria-label={Web.I18n.t("theme.dark", @locale)}
          title={Web.I18n.t("theme.dark", @locale)}
          phx-click="set-theme"
          phx-value-theme="dark"
        ><.icon name="moon" class="h-4 w-4" /></button>
      </div>

      <button
        type="button"
        class="inline-flex min-h-9 min-w-10 items-center justify-center rounded-md border border-border bg-transparent px-2 text-xs font-semibold text-foreground hover:bg-panel-hover"
        aria-label={
          Web.I18n.t("language.switch", @locale, %{
            language: if(@locale == "en", do: "Nederlands", else: "English")
          })
        }
        title={Web.I18n.t("language.label", @locale)}
        phx-click="set-locale"
        phx-value-locale={if(@locale == "en", do: "nl", else: "en")}
      >
        {String.upcase(@locale)}
      </button>

      <button
        type="button"
        class="hidden min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover sm:inline-flex"
        aria-label={Web.I18n.t("tour.start", @locale)}
        title={Web.I18n.t("tour.start", @locale)}
        phx-click="open-tour"
      >
        <.icon name="tour" class="h-4 w-4" />
      </button>

      <button
        type="button"
        class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover max-[640px]:hidden"
        aria-label={Web.I18n.t("common.shortcuts", @locale)}
        title={Web.I18n.t("common.shortcuts", @locale)}
        phx-click="open-shortcuts"
      >
        <.icon name="question" class="h-4 w-4" />
      </button>
    </nav>
  </header>
  {@inner_content}
  <div
    :if={@ui_modal == "shortcuts"}
    class="modal-backdrop fixed inset-0 z-[60] grid place-items-center p-4"
  >
    <section
      class="max-h-[90dvh] w-full max-w-xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="shortcuts-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="shortcuts-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("shortcuts.title", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div class="grid gap-4 sm:grid-cols-2">
        <section>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
            {Web.I18n.t("shortcuts.anywhereHeading", @locale)}
          </h3>

          <dl class="space-y-2 text-sm">
            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.firstLast", @locale)}</dt><dd class="m-0 font-mono text-muted">
                Home / End
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.previousNext", @locale)}</dt><dd class="m-0 font-mono text-muted">
                ← / →
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.flip", @locale)}</dt><dd class="m-0 font-mono text-muted">
                F
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.focusBoard", @locale)}</dt><dd class="m-0 font-mono text-muted">
                B
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.focusMoveTree", @locale)}</dt><dd class="m-0 font-mono text-muted">
                M
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.helpRow", @locale)}</dt><dd class="m-0 font-mono text-muted">
                ?
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.escRow", @locale)}</dt><dd class="m-0 font-mono text-muted">
                Esc
              </dd>
            </div>
          </dl>
        </section>

        <section>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
            {Web.I18n.t("shortcuts.boardHeading", @locale)}
          </h3>

          <dl class="space-y-2 text-sm">
            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardCursor", @locale)}</dt><dd class="m-0 font-mono text-muted">
                ← ↑ → ↓
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.previousNext", @locale)}</dt><dd class="m-0 font-mono text-muted">
                Shift + ← / →
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardSelect", @locale)}</dt><dd class="m-0 font-mono text-muted">
                Enter
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardHighlight", @locale)}</dt><dd class="m-0 font-mono text-muted">
                H
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardArrow", @locale)}</dt><dd class="m-0 font-mono text-muted">
                A
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardCancel", @locale)}</dt><dd class="m-0 font-mono text-muted">
                Esc
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt>{Web.I18n.t("shortcuts.boardColor", @locale)}</dt><dd class="m-0 font-mono text-muted">
                1–5
              </dd>
            </div>
          </dl>
        </section>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "tour"}
    class="modal-backdrop fixed inset-0 z-[60] grid place-items-center p-4"
  >
    <% {title_key, body_key} = Web.Layouts.tour_step(@tour_step) %>
    <section
      class="max-h-[90dvh] w-full max-w-2xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tour-title"
      data-tour-dialog
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-widest text-muted">
          {Web.I18n.t("tour.label", @locale)}
        </p>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <h2 id="tour-title" class="mb-2 mt-0 text-xl font-semibold">
        {Web.I18n.t(title_key, @locale)}
      </h2>

      <p class="text-muted">{Web.I18n.t(body_key, @locale)}</p>

      <div class="mt-5 flex items-center justify-between gap-2">
        <button
          type="button"
          class="inline-flex min-h-9 items-center justify-center rounded-md border border-border bg-transparent px-3 text-foreground hover:bg-panel-hover"
          phx-click="close-modal"
        >{Web.I18n.t("tour.skip", @locale)}</button>
        <span class="text-xs tabular-nums text-muted">{Web.I18n.t("tour.progress", @locale, %{
          current: @tour_step,
          total: Web.Layouts.tour_steps_count()
        })}</span>
        <div class="flex gap-2">
          <button
            type="button"
            class="rounded-md border border-border px-3 py-2 text-sm disabled:opacity-40"
            phx-click="tour-back"
            disabled={@tour_step <= 1}
          >{Web.I18n.t("tour.back", @locale)}</button>
          <button
            type="button"
            class="rounded-md border border-accent bg-accent px-3 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
            phx-click="tour-next"
          >{if @tour_step >= Web.Layouts.tour_steps_count(),
            do: Web.I18n.t("tour.done", @locale),
            else: Web.I18n.t("tour.next", @locale)}</button>
        </div>
      </div>
    </section>
  </div>
</div>
