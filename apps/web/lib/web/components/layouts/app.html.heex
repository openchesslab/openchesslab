<div
  id="app-shell"
  class="min-h-screen bg-canvas text-foreground"
  data-theme={@theme}
  data-room-code={@room_code}
  phx-hook="AppUI"
>
  <a
    href="#main-content"
    class="absolute -top-20 left-3 z-[100] rounded bg-accent px-3 py-2 text-white focus:top-3"
  >{Web.I18n.t("common.skipToContent", @locale)}</a>
  <header class="sticky top-0 z-30 flex min-h-[3.4rem] flex-wrap items-center justify-between gap-3 border-b border-border bg-panel px-4 py-1">
    <.link
      navigate={~p"/"}
      class="flex min-w-0 items-center gap-2 font-semibold tracking-tight text-foreground no-underline"
    >
      <img
        src="/brand/openchesslab-mark-dark.svg"
        alt=""
        class="theme-light:hidden h-8 w-8"
      />
      <img
        src="/brand/openchesslab-mark-light.svg"
        alt=""
        class="hidden theme-light:block h-8 w-8"
      /> <span class="hidden sm:inline">OpenChessLab</span>
    </.link>

    <nav
      class="flex items-center gap-1"
      aria-label={Web.I18n.t("common.applicationSettings", @locale)}
    >
      <button
        :if={@room_code}
        type="button"
        class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-transparent bg-transparent px-2 text-foreground hover:border-border hover:bg-panel-hover"
        aria-label={Web.I18n.t("room.importSearchTitle", @locale)}
        title={Web.I18n.t("room.importSearchTitle", @locale)}
        data-tour="search"
        phx-click="open-search"
      >
        <.icon name="search" class="h-4 w-4" />
      </button>

      <form
        :if={@room_code}
        id="piece-set-desktop-form"
        phx-change="set-piece-set"
        class="hidden sm:block"
      >
        <label class="sr-only" for="piece-set-desktop">{Web.I18n.t("pieceSet.menu", @locale)}</label>
        <select
          id="piece-set-desktop"
          name="piece_set"
          class="max-w-32 rounded-md border border-border bg-panel px-2 py-2 text-xs text-foreground"
          aria-label={Web.I18n.t("pieceSet.menu", @locale)}
        >
          <option value="merida" selected={@piece_set == "merida"}>Merida</option>

          <option value="cburnett" selected={@piece_set == "cburnett"}>Cburnett</option>
        </select>
      </form>

      <details
        :if={@room_code}
        id="piece-set-menu"
        name="header-menu"
        class="relative sm:hidden"
        phx-click-away={JS.remove_attribute("open", to: "#piece-set-menu")}
        phx-window-keydown={JS.remove_attribute("open", to: "#piece-set-menu")}
        phx-key="Escape"
      >
        <summary
          class="inline-flex min-h-9 cursor-pointer list-none items-center justify-center rounded-md border border-border px-2 text-xs font-semibold hover:bg-panel-hover [&::-webkit-details-marker]:hidden"
          aria-label={Web.I18n.t("pieceSet.menu", @locale)}
          title={Web.I18n.t("pieceSet.menu", @locale)}
        >
          <.icon name="settings" class="h-4 w-4" />
        </summary>
        <div class="absolute left-0 top-full z-40 mt-2 flex w-56 flex-col gap-1 rounded-lg border border-border bg-panel p-2 shadow-xl">
          <form id="piece-set-mobile-form" phx-change="set-piece-set">
            <label for="piece-set-mobile" class="flex flex-col gap-1 text-xs text-muted">
              {Web.I18n.t("pieceSet.menu", @locale)}
              <select
                id="piece-set-mobile"
                name="piece_set"
                class="rounded-md border border-border bg-canvas px-2 py-2 text-sm text-foreground"
              >
                <option value="merida" selected={@piece_set == "merida"}>Merida</option>

                <option value="cburnett" selected={@piece_set == "cburnett"}>Cburnett</option>
              </select>
            </label>
          </form>
        </div>
      </details>

      <button
        id="theme-cycle"
        type="button"
        class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border px-2 hover:bg-panel-hover"
        aria-label={theme_cycle_label(@theme, @locale)}
        title={theme_cycle_label(@theme, @locale)}
        phx-click="set-theme"
        phx-value-theme={next_theme(@theme)}
      ><.icon name={theme_icon(@theme)} class="h-4 w-4" /></button>

      <button
        type="button"
        class="inline-flex min-h-9 min-w-10 items-center justify-center rounded-md border border-border bg-transparent px-2 text-xs font-semibold text-foreground hover:bg-panel-hover"
        aria-label={
          Web.I18n.t("language.switch", @locale, %{
            language: if(@locale == "en", do: "Nederlands", else: "English")
          })
        }
        title={Web.I18n.t("language.label", @locale)}
        phx-click="set-locale"
        phx-value-locale={if(@locale == "en", do: "nl", else: "en")}
      >
        {String.upcase(@locale)}
      </button>

      <details
        :if={@room_code}
        id="help-menu"
        name="header-menu"
        class="relative"
        phx-click-away={JS.remove_attribute("open", to: "#help-menu")}
        phx-window-keydown={JS.remove_attribute("open", to: "#help-menu")}
        phx-key="Escape"
      >
        <summary
          class="inline-flex min-h-9 min-w-9 cursor-pointer list-none items-center justify-center rounded-md border border-border px-2 text-xs font-semibold hover:bg-panel-hover [&::-webkit-details-marker]:hidden"
          aria-label={Web.I18n.t("common.help", @locale)}
          title={Web.I18n.t("common.help", @locale)}
          data-tour="help"
        >
          <.icon name="question" class="h-4 w-4" />
        </summary>
        <div class="absolute right-0 top-full z-40 mt-2 flex w-56 flex-col gap-1 rounded-lg border border-border bg-panel p-2 shadow-xl">
          <button
            id="help-shortcuts"
            type="button"
            class="block w-full rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            phx-click={JS.remove_attribute("open", to: "#help-menu") |> JS.push("open-shortcuts")}
          >{Web.I18n.t("common.shortcuts", @locale)}</button>
          <button
            id="help-tour"
            type="button"
            class="block w-full rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            phx-click={JS.remove_attribute("open", to: "#help-menu") |> JS.push("open-tour")}
          >{Web.I18n.t("tour.start", @locale)}</button>
        </div>
      </details>

      <details
        :if={@current_user || @login_enabled || @google_login_enabled}
        id="account-menu"
        name="header-menu"
        class="relative"
        phx-click-away={JS.remove_attribute("open", to: "#account-menu")}
        phx-window-keydown={JS.remove_attribute("open", to: "#account-menu")}
        phx-key="Escape"
      >
        <summary
          class="inline-flex min-h-9 min-w-9 cursor-pointer list-none items-center justify-center rounded-md border border-border px-2 text-xs font-semibold hover:bg-panel-hover [&::-webkit-details-marker]:hidden"
          aria-label={Web.I18n.t("auth.account", @locale)}
          title={Web.I18n.t("auth.account", @locale)}
        >
          <%= if @current_user do %>
            <% account_name = @session_name %>
            <span
              id="account-badge"
              class="grid h-6 w-6 place-items-center rounded-full text-[.6rem] font-bold text-white"
              style={"background-color: " <> Web.DisplayName.name_color(account_name)}
              title={account_name}
            >{Web.DisplayName.initials(account_name)}</span>
          <% else %>
            <.icon name="person" class="h-4 w-4" />
          <% end %>
        </summary>
        <div class="absolute right-0 top-full z-40 mt-2 flex w-56 flex-col gap-1 rounded-lg border border-border bg-panel p-2 shadow-xl">
          <div
            :if={@current_user}
            id="account-identity"
            class="mb-1 flex items-center gap-2 border-b border-border pb-2"
          >
            <% account_name = @session_name %>
            <span
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-xs font-bold text-white"
              style={"background-color: " <> Web.DisplayName.name_color(account_name)}
            >{Web.DisplayName.initials(account_name)}</span>
            <div class="min-w-0 flex-1">
              <p class="m-0 truncate text-sm font-semibold text-foreground">{account_name}</p>
              <p class="m-0 text-xs text-muted">{Web.I18n.t("auth.signedIn", @locale)}</p>
            </div>
            <span
              id="account-name-help"
              class="cursor-help self-start text-muted hover:text-foreground"
              title={Web.I18n.t("auth.generatedNameHelp", @locale)}
              aria-label={Web.I18n.t("auth.generatedNameHelp", @locale)}
            ><.icon name="question" class="h-3.5 w-3.5" /></span>
          </div>

          <button
            :if={@current_user}
            type="button"
            id="personal-library-button"
            class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            phx-click={
              JS.remove_attribute("open", to: "#account-menu") |> JS.push("open-library")
            }
          >
            <.icon name="library" class="h-4 w-4" />
            {Web.I18n.t("library.title", @locale)}
          </button>
          <button
            :if={@current_user}
            type="button"
            id="linked-accounts-button"
            class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            phx-click={
              JS.remove_attribute("open", to: "#account-menu") |> JS.push("open-account")
            }
          >
            <.icon name="link" class="h-4 w-4" />
            {Web.I18n.t("auth.connections", @locale)}
          </button>
          <.form
            :if={@current_user}
            for={%{}}
            id="auth-logout"
            action={~p"/auth/logout"}
            method="post"
          >
            <input
              :if={@room_code}
              type="hidden"
              name="return_to"
              value={~p"/rooms/#{@room_code}"}
            />
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            >
              <.icon name="logout" class="h-4 w-4" />
              {Web.I18n.t("auth.logout", @locale)}
            </button>
          </.form>
          <.form
            :if={!@current_user && @login_enabled}
            for={%{}}
            id="auth-login"
            action={~p"/auth/lichess"}
            method="post"
          >
            <input
              :if={@room_code}
              type="hidden"
              name="return_to"
              value={~p"/rooms/#{@room_code}"}
            />
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            >
              <.lichess_mark class="h-4 w-4" />
              {Web.I18n.t("auth.loginWithLichess", @locale)}
            </button>
          </.form>
          <.form
            :if={!@current_user && @google_login_enabled}
            for={%{}}
            id="auth-google-login"
            action={~p"/auth/google"}
            method="post"
          >
            <input
              :if={@room_code}
              type="hidden"
              name="return_to"
              value={~p"/rooms/#{@room_code}"}
            />
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-panel-hover"
            >
              <.google_mark class="h-4 w-4" />
              {Web.I18n.t("auth.loginWithGoogle", @locale)}
            </button>
          </.form>
        </div>
      </details>
    </nav>
  </header>
  <p
    :if={Phoenix.Flash.get(@flash, :error)}
    id="app-error"
    role="alert"
    class="m-4 rounded-md border border-border-strong bg-panel p-3 text-sm text-foreground"
  >
    {Phoenix.Flash.get(@flash, :error)}
  </p>
  {@inner_content}
  <div
    :if={@ui_modal == "shortcuts"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-2xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="shortcuts-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="shortcuts-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("shortcuts.title", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div class="grid gap-4 sm:grid-cols-2">
        <section>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
            {Web.I18n.t("shortcuts.anywhereHeading", @locale)}
          </h3>

          <dl class="space-y-2 text-sm">
            <.shortcut_row label={Web.I18n.t("shortcuts.firstLast", @locale)}>
              <kbd>Home</kbd> / <kbd>End</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.previousNext", @locale)}>
              <kbd>←</kbd> / <kbd>→</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.flip", @locale)}>
              <kbd>F</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.focusBoard", @locale)}>
              <kbd>B</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.focusMoveTree", @locale)}>
              <kbd>M</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.helpRow", @locale)}>
              <kbd>?</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.escRow", @locale)}>
              <kbd>Esc</kbd>
            </.shortcut_row>
          </dl>
        </section>

        <section>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
            {Web.I18n.t("shortcuts.boardHeading", @locale)}
          </h3>

          <dl class="space-y-2 text-sm">
            <.shortcut_row label={Web.I18n.t("shortcuts.boardCursor", @locale)}>
              <kbd>←</kbd> <kbd>↑</kbd> <kbd>→</kbd> <kbd>↓</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.previousNext", @locale)}>
              <kbd>Shift</kbd> + <kbd>←</kbd> / <kbd>→</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.boardSelect", @locale)}>
              <kbd>Enter</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.boardHighlight", @locale)}>
              <kbd>H</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.boardArrow", @locale)}>
              <kbd>A</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.boardCancel", @locale)}>
              <kbd>Esc</kbd>
            </.shortcut_row>
            <.shortcut_row label={Web.I18n.t("shortcuts.boardColor", @locale)}>
              <kbd>1</kbd>–<kbd>5</kbd>
            </.shortcut_row>
          </dl>
        </section>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "tour"}
    id="tour-overlay"
    class="fixed inset-0 z-[60]"
    phx-hook="GuidedTour"
    data-tour-target={elem(Web.Layouts.tour_step(@tour_step), 0)}
  >
    <% {_target, title_key, body_key} = Web.Layouts.tour_step(@tour_step) %>
    <div data-tour-backdrop class="fixed inset-0 backdrop-blur-xs backdrop-saturate-[.9]"></div>
    <div
      data-tour-ring
      class="pointer-events-none fixed rounded-lg border-2 border-accent"
      style="display: none"
    >
    </div>
    <section
      data-tour-card
      class="fixed left-1/2 top-1/2 max-h-[90dvh] w-full max-w-sm -translate-x-1/2 -translate-y-1/2 overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tour-title"
      data-tour-dialog
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-widest text-muted">
          {Web.I18n.t("tour.label", @locale)}
        </p>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <h2 id="tour-title" class="mb-2 mt-0 text-xl font-semibold">
        {Web.I18n.t(title_key, @locale)}
      </h2>

      <p class="text-muted">{Web.I18n.t(body_key, @locale)}</p>

      <div class="mt-5 flex items-center justify-between gap-2">
        <button
          type="button"
          class="inline-flex min-h-9 items-center justify-center rounded-md border border-border bg-transparent px-3 text-foreground hover:bg-panel-hover"
          phx-click="close-modal"
        >{Web.I18n.t("tour.skip", @locale)}</button>
        <span class="text-xs tabular-nums text-muted">{Web.I18n.t("tour.progress", @locale, %{
          current: @tour_step,
          total: Web.Layouts.tour_steps_count()
        })}</span>
        <div class="flex gap-2">
          <button
            type="button"
            class="rounded-md border border-border px-3 py-2 text-sm disabled:opacity-40"
            phx-click="tour-back"
            disabled={@tour_step <= 1}
          >{Web.I18n.t("tour.back", @locale)}</button>
          <button
            type="button"
            class="rounded-md border border-accent bg-accent px-3 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
            phx-click="tour-next"
          >{if @tour_step >= Web.Layouts.tour_steps_count(),
            do: Web.I18n.t("tour.done", @locale),
            else: Web.I18n.t("tour.next", @locale)}</button>
        </div>
      </div>
    </section>
  </div>

  <.library_modal
    :if={@ui_modal == "library"}
    locale={@locale}
    current_user={@current_user}
    entries={@library_entries}
    cursor={@library_cursor}
    next_cursor={@library_next_cursor}
    editing={@library_editing}
    title_error={@library_title_error}
  />

  <.account_modal
    :if={@ui_modal == "account"}
    locale={@locale}
    current_user={@current_user}
    login_enabled={@login_enabled}
    google_login_enabled={@google_login_enabled}
    providers={@providers}
    account_error={@account_error}
    account_delete_armed={@account_delete_armed}
    room_code={@room_code}
  />
</div>
