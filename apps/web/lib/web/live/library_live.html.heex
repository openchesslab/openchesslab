<main id="main-content" class="mx-auto w-full max-w-3xl px-4 py-8 sm:py-12">
  <nav class="mb-8 flex items-center justify-between gap-3">
    <.link href={~p"/"} class="text-sm text-foreground underline">OpenChessLab</.link>
    <.form for={%{}} id="auth-logout" action={~p"/auth/logout"} method="post">
      <button
        type="submit"
        class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
      >
        {Web.I18n.t("auth.logout", @locale)}
      </button>
    </.form>
  </nav>
  <h1 class="mb-3 text-2xl font-semibold">{Web.I18n.t("library.title", @locale)}</h1>
  <p class="mb-6 text-sm text-muted">{Web.I18n.t("library.description", @locale)}</p>
  <p
    :if={@entries == []}
    id="library-empty"
    class="rounded-lg border border-border bg-panel p-5 text-muted"
  >
    {Web.I18n.t("library.empty", @locale)}
  </p>
  <ul id="library-entries" class="space-y-3">
    <li
      :for={entry <- @entries}
      id={"saved-#{entry.id}"}
      class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-panel p-4"
    >
      <div class="min-w-0">
        <.link
          navigate={~p"/library/#{entry.id}"}
          class="m-0 break-all font-mono text-sm underline"
        >{entry.id}</.link>
        <p class="mt-1 text-xs text-muted">
          {Web.I18n.t("library.saved", @locale)}
          <time datetime={NaiveDateTime.to_iso8601(entry.saved_at) <> "Z"}>{Calendar.strftime(
            entry.saved_at,
            "%Y-%m-%d"
          )}</time>
        </p>
      </div>
      <button
        type="button"
        phx-click="remove"
        phx-value-id={entry.id}
        class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
      >
        {Web.I18n.t("library.remove", @locale)}
      </button>
    </li>
  </ul>
  <nav class="mt-6 flex gap-3" aria-label={Web.I18n.t("library.pages", @locale)}>
    <button
      :if={@cursor}
      type="button"
      phx-click="first-page"
      class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
    >{Web.I18n.t("library.first", @locale)}</button>
    <button
      :if={@next_cursor}
      type="button"
      phx-click="next-page"
      class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
    >{Web.I18n.t("library.next", @locale)}</button>
  </nav>
</main>
