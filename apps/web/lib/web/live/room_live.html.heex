<main id="main-content" class="min-h-0 overflow-hidden max-[860px]:overflow-visible">
  <section :if={is_nil(@room)} class="mx-auto max-w-2xl px-4 py-12 text-center">
    <h1 class="text-2xl font-semibold">
      {Web.I18n.t("room.loadFailed", @locale, %{message: @error || "not found"})}
    </h1>

    <.link
      navigate={~p"/"}
      class="mt-5 inline-flex items-center rounded-md border border-border px-4 py-2 text-foreground hover:bg-panel-hover"
    >
      OpenChessLab
    </.link>
  </section>

  <div
    :if={@room}
    id="room-shell"
    phx-hook="RoomTabs"
    class="grid h-[calc(100dvh-3.4rem)] min-h-[38rem] grid-cols-[270px_minmax(0,1fr)] overflow-hidden border-t border-border max-[860px]:flex max-[860px]:min-h-0 max-[860px]:flex-col"
  >
    <aside class="flex min-h-0 flex-col gap-3 overflow-hidden border-r border-border p-3 max-[860px]:contents">
      <div class="shrink-0 border-b border-border pb-3 max-[860px]:order-1 max-[860px]:flex max-[860px]:flex-nowrap max-[860px]:items-center max-[860px]:gap-2 max-[860px]:overflow-hidden max-[860px]:px-3 max-[860px]:py-1.5">
        <header class="flex flex-wrap items-center justify-between gap-2 max-[860px]:contents">
          <h1 class="m-0 text-xl font-semibold max-[860px]:whitespace-nowrap max-[860px]:text-base">
            <span class="max-[860px]:hidden">{Web.I18n.t("room.label", @locale)}</span>
            <code class="font-mono text-base text-muted max-[860px]:text-sm">{@room_code}</code>
          </h1>

          <div class="flex items-center gap-1">
            <button
              type="button"
              class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover"
              aria-label={Web.I18n.t("common.copyCode", @locale)}
              title={Web.I18n.t("common.copyCode", @locale)}
              phx-click="copy-room-code"
            >
              <.icon name="copy" class="h-4 w-4" />
            </button>
          </div>
        </header>

        <div
          class="mt-3 flex flex-nowrap items-center gap-x-2 gap-y-1 max-[860px]:mt-0"
          role="status"
          aria-live="polite"
        >
          <span class="h-2 w-2 rounded-full bg-success" aria-hidden="true"></span>
          <span class="text-xs font-medium text-muted max-[860px]:hidden">{Web.I18n.t(
            "room.live",
            @locale
          )}</span>
          <span class="text-xs text-muted max-[860px]:whitespace-nowrap">{Web.I18n.plural(
            "room.participantCount",
            map_size(@participants),
            %{}
          )}</span>
          <ul class="m-0 flex list-none items-center gap-1 p-0">
            <%= for {id, meta} <- @participants do %>
              <% viewing = meta.analysis_id && Enum.find(@analyses, &(&1.id == meta.analysis_id)) %> <% viewer_title =
                if viewing, do: "#{meta.display_name} — #{viewing.label}", else: meta.display_name %>
              <li>
                <button
                  :if={id != @participant_id and meta.analysis_id}
                  type="button"
                  class="grid h-7 w-7 place-items-center rounded-full border border-border bg-panel-hover text-[.65rem] font-bold text-foreground hover:border-accent-strong"
                  title={viewer_title}
                  aria-label={Web.I18n.t("room.followViewer", @locale) <> ": " <> meta.display_name}
                  phx-click="follow-viewer"
                  phx-value-analysis_id={meta.analysis_id}
                  phx-value-path={Enum.join(meta.path || [], ",")}
                >{initials(meta.display_name)}</button>
                <span
                  :if={id == @participant_id or is_nil(meta.analysis_id)}
                  class="grid h-7 w-7 place-items-center rounded-full border border-border bg-panel-hover text-[.65rem] font-bold text-muted"
                  title={viewer_title}
                >{initials(meta.display_name)}</span>
              </li>
            <% end %>
          </ul>
        </div>

        <div
          class="mt-2 flex items-center gap-1 text-xs text-muted max-[860px]:mt-0 max-[860px]:whitespace-nowrap"
          title={region_tooltip(@local_region, @room_region, @locale)}
        >
          <span aria-hidden="true">{region_badge(@local_region)}{if @room_region &&
                                                                      @room_region !=
                                                                        @local_region,
                                                                    do:
                                                                      "↔" <>
                                                                        region_badge(@room_region),
                                                                    else: ""}</span>
          <span data-latency class="tabular-nums">— ms</span>
          <span class="sr-only">{region_tooltip(@local_region, @room_region, @locale)}</span>
        </div>

        <p :if={@error} role="alert" class="mt-2 text-sm text-error">{@error}</p>
      </div>

      <section
        data-mobile-panel="games"
        class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto max-[860px]:order-4 max-[860px]:px-3 max-[860px]:py-3"
        aria-label={Web.I18n.t("room.analyses", @locale)}
      >
        <header class="flex items-center justify-between gap-2">
          <h2 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
            {Web.I18n.t("room.analyses", @locale)}
            <span class="ml-1 rounded-full bg-panel-hover px-1.5 py-0.5 text-xs text-foreground">{length(
              @analyses
            )}</span>
          </h2>

          <div class="flex items-center gap-1">
            <button
              type="button"
              class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover"
              title={Web.I18n.t("room.importTitle", @locale)}
              aria-label={Web.I18n.t("room.importTitle", @locale)}
              phx-click="open-import"
            ><.icon name="import" class="h-4 w-4" /></button>
            <button
              type="button"
              class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover"
              title={Web.I18n.t("room.newAnalysis", @locale)}
              aria-label={Web.I18n.t("room.newAnalysis", @locale)}
              phx-click="create-analysis"
            ><.icon name="add" class="h-4 w-4" /></button>
          </div>
        </header>

        <button
          type="button"
          class="self-start rounded-md px-2 py-1 text-xs text-muted hover:bg-panel-hover hover:text-foreground"
          phx-click="open-setup"
        >{Web.I18n.t("room.setupPosition", @locale)}</button>
        <p
          :if={@analyses == []}
          class="rounded-lg border border-dashed border-border p-3 text-sm text-muted"
        >
          {Web.I18n.t("room.noAnalyses", @locale)}
        </p>

        <ul :if={@analyses != []} class="m-0 flex list-none flex-col gap-1 p-0">
          <%= for analysis <- @analyses do %>
            <% active = analysis.id == @selected_analysis_id %> <% viewers =
              analysis_viewers(analysis.id, @participants, @participant_id) %>
            <li>
              <button
                type="button"
                class={[
                  "flex w-full flex-col items-start rounded-md border px-3 py-2 text-left transition-colors",
                  active &&
                    "border-highlight/40 bg-highlight/15 shadow-[inset_2px_0_0_var(--highlight)]",
                  not active && "border-transparent hover:bg-panel-hover"
                ]}
                aria-pressed={if active, do: "true", else: "false"}
                aria-current={if active, do: "true", else: nil}
                phx-click="select-analysis"
                phx-value-id={analysis.id}
              >
                <span class="flex w-full items-center justify-between gap-2 text-sm font-semibold text-foreground">
                  <span class="truncate">{analysis.label}</span>
                  <span
                    :if={viewers > 0}
                    class="shrink-0 rounded-full bg-panel-hover px-1.5 py-0.5 text-[.65rem] text-muted"
                  >{viewers}</span>
                </span>
                <span class="text-xs text-muted">{analysis.detail}</span>
              </button>
            </li>
          <% end %>
        </ul>
      </section>

      <section
        data-mobile-panel="chat"
        class="flex shrink-0 flex-col gap-2 border-t border-border pt-3 max-[860px]:order-5 max-[860px]:px-3 max-[860px]:py-3"
        aria-label={Web.I18n.t("room.chatHeading", @locale)}
      >
        <h2 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
          {Web.I18n.t(
            "room.chatHeading",
            @locale
          )}
        </h2>

        <div
          id="chat-log"
          phx-hook="ScrollLog"
          phx-update="stream"
          role="log"
          aria-live="polite"
          class="flex max-h-40 min-h-16 flex-col gap-2 overflow-y-auto pr-1 max-[860px]:min-h-0 max-[860px]:max-h-none max-[860px]:flex-1"
        >
          <article
            :for={{dom_id, message} <- @streams.chat_messages}
            id={dom_id}
            class={[
              "max-w-[95%] rounded-lg border border-border bg-panel px-2.5 py-2",
              message.author_id == @participant_id && "self-end bg-panel-hover"
            ]}
          >
            <header class="flex items-center justify-between gap-3 text-[.68rem] text-muted">
              <strong class="truncate font-medium">{if message.author_id == @participant_id,
                do: Web.I18n.t("room.chatYou", @locale),
                else: message.author}</strong>
              <time class="shrink-0 tabular-nums">{Web.I18n.format_time(message.at)}</time>
            </header>

            <p class="mb-0 mt-1 whitespace-pre-wrap break-words text-xs text-foreground">
              {message.text}
            </p>

            <p
              :if={chat_context(message, @analyses)}
              class="mb-0 mt-1 truncate text-[.65rem] text-muted"
            >
              {Web.I18n.t("room.chatViewing", @locale, %{label: chat_context(message, @analyses)})}
            </p>
          </article>
        </div>

        <p :if={@chat_messages == []} class="m-0 text-xs text-muted">
          {Web.I18n.t("room.chatEmpty", @locale)}
        </p>

        <form phx-submit="send-chat" class="flex gap-1.5">
          <label class="sr-only" for="chat-message">{Web.I18n.t("room.chatPlaceholder", @locale)}</label>
          <input
            id="chat-message"
            name="message"
            maxlength="2000"
            autocomplete="off"
            placeholder={Web.I18n.t("room.chatPlaceholder", @locale)}
            class="min-w-0 flex-1 rounded-md border border-border px-2.5 py-2 text-xs"
          />
          <button
            type="submit"
            class="rounded-md border border-border bg-transparent px-2.5 text-xs font-medium text-foreground hover:bg-panel-hover"
          >{Web.I18n.t("room.chatSend", @locale)}</button>
        </form>

        <p :if={@chat_error} role="alert" class="m-0 text-xs text-error">{@chat_error}</p>
      </section>
    </aside>

    <section class="grid min-h-0 min-w-0 grid-cols-[minmax(0,1fr)_360px] overflow-hidden max-[1100px]:grid-cols-[minmax(0,1fr)_320px] max-[860px]:contents">
      <%= if @analysis do %>
        <section
          class="grid min-h-0 min-w-0 grid-rows-[minmax(0,1fr)_auto] gap-2 overflow-hidden p-3 max-[860px]:order-2 max-[860px]:flex max-[860px]:min-h-0 max-[860px]:flex-1 max-[860px]:flex-col max-[860px]:gap-1 max-[860px]:p-1.5"
          aria-label={Web.I18n.t("room.boardHeading", @locale)}
        >
          <div class="flex min-h-0 flex-col gap-2 overflow-y-auto max-[860px]:min-h-0 max-[860px]:flex-1 max-[860px]:gap-1 max-[860px]:overflow-hidden">
            <div
              class="relative flex min-h-0 flex-1 items-center justify-center gap-3 max-[860px]:min-h-0 max-[860px]:flex-wrap"
              data-tour="board"
              data-board-zone
            >
              <div class={
                if @engine_on and @engine_preview,
                  do:
                    "flex min-h-0 min-w-0 flex-1 items-center justify-center gap-3 max-[860px]:w-full",
                  else: "contents"
              }>
                <div
                  :if={@engine_on and @engine_preview}
                  id="evaluation-bar"
                  class="relative h-[min(calc(100dvh-14rem),42rem)] w-9 shrink-0 overflow-visible rounded border border-border max-[860px]:h-[min(100vw,32rem)]"
                  data-eval-bar
                  phx-hook="EvalBar"
                  role="img"
                  aria-label={
                    Web.I18n.t("demo.evaluationBar", @locale) <> " " <> eval_label(@engine_preview)
                  }
                  title={eval_label(@engine_preview)}
                >
                  <div class="absolute inset-0 overflow-hidden rounded bg-[#17191f]">
                    <div
                      class="absolute inset-x-0 bg-white"
                      style={eval_fill_style(@engine_preview, @orientation)}
                    >
                    </div>

                    <div class="absolute inset-x-0 top-1/2 h-px bg-white/75"></div>
                  </div>

                  <span
                    class="absolute left-1/2 z-10 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded border border-border bg-panel px-0.5 py-0.5 text-[.55rem] font-mono font-semibold text-foreground"
                    style={
                      "top:clamp(1rem,#{eval_label_position(@engine_preview, @orientation)}%,calc(100% - 1rem))"
                    }
                  >{eval_label(@engine_preview)}</span>
                </div>

                <%= if @position do %>
                  <.chess_board
                    position={@draft_position || @position}
                    locale={@locale}
                    orientation={@orientation}
                    center={not @engine_on or is_nil(@engine_preview)}
                    selected_square={@selected_square}
                    cursor_square={@cursor_square}
                    legal_targets={if @draft_position, do: [], else: @legal_targets}
                    shapes={@board_shapes}
                    annotation_color={@annotation_color}
                    piece_set={@piece_set}
                    layers={@layers}
                    insights={if @draft_position, do: %{}, else: @insights || %{}}
                    last_from={if @draft_position, do: nil, else: @last_from}
                    last_to={if @draft_position, do: nil, else: @last_to}
                    check_squares={
                      if @draft_position,
                        do: [],
                        else: AnalysisView.checked_king_squares(@position)
                    }
                    play={
                      @ui_modal != "setup" and not @edit_mode and is_nil(@draft_position) and
                        is_nil(@armed_piece) and not @remove_armed
                    }
                  />
                <% else %>
                  <p class="text-sm text-muted">
                    {Web.I18n.t("room.positionUnavailable", @locale)}
                  </p>
                <% end %>
              </div>

              <p
                data-arrow-hint
                class="pointer-events-none absolute left-1/2 top-2 z-30 hidden -translate-x-1/2 items-center gap-1 whitespace-nowrap rounded-full border border-highlight bg-panel px-3 py-1 text-xs text-highlight shadow-xl in-data-[board-arrow=armed]:inline-flex"
                role="status"
                aria-live="polite"
              >
                {Web.I18n.t("room.arrowFrom", @locale)} <strong data-arrow-from></strong>
                <span class="max-[860px]:hidden">{Web.I18n.t("room.arrowHint", @locale)}</span>
              </p>

              <aside
                :if={@position_editor_open and not is_nil(@position)}
                class="max-h-full w-60 shrink-0 overflow-y-auto rounded-lg border border-border bg-panel p-3 max-[860px]:fixed max-[860px]:inset-x-0 max-[860px]:bottom-0 max-[860px]:top-[42dvh] max-[860px]:z-40 max-[860px]:max-h-none max-[860px]:w-auto max-[860px]:rounded-b-none max-[860px]:border-x-0 max-[860px]:border-b-0 max-[860px]:shadow-2xl"
                aria-label={Web.I18n.t("room.positionEditor", @locale)}
              >
                <header class="mb-2 flex items-center justify-between gap-2">
                  <h3 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
                    {Web.I18n.t("room.positionEditor", @locale)}
                  </h3>

                  <button
                    type="button"
                    class="rounded border border-border px-2 py-1 text-xs hover:bg-panel-hover"
                    aria-label={Web.I18n.t("common.close", @locale)}
                    phx-click="toggle-position-editor"
                  ><.icon name="close" class="h-4 w-4" /></button>
                </header>

                <p class="mb-3 mt-0 text-[.68rem] text-muted">
                  {Web.I18n.t("room.editorHint", @locale)}
                </p>

                <p class="mb-1 mt-0 text-[.68rem] font-semibold uppercase tracking-wider text-muted">
                  {Web.I18n.t("room.toolsHeading", @locale)}
                </p>

                <div
                  id="editor-palette"
                  phx-hook="PaletteDrag"
                  class="mb-3 grid w-full touch-none select-none max-w-[15rem] grid-cols-4 gap-1 max-[860px]:mx-auto"
                >
                  <%= for {color, kind} <- piece_palette() do %>
                    <% code = Atom.to_string(color) <> "_" <> Atom.to_string(kind) %>
                    <button
                      type="button"
                      data-piece-code={code}
                      class={[
                        "grid aspect-square place-items-center rounded border border-border bg-board-light text-2xl hover:brightness-95",
                        @armed_piece == code && "ring-2 ring-accent-strong"
                      ]}
                      aria-label={piece_name(kind, color, @locale)}
                      title={piece_name(kind, color, @locale)}
                      phx-click="arm-piece"
                      phx-value-piece={code}
                    ><.piece_icon
                      kind={kind}
                      color={color}
                      piece_set={@piece_set}
                      class="h-[90%] w-[90%]"
                    /></button>
                  <% end %>
                </div>

                <div class="mb-3 flex gap-1">
                  <button
                    type="button"
                    class={[
                      "flex-1 rounded border px-2 py-1.5 text-xs",
                      @remove_armed && "border-error bg-error/10 text-error",
                      not @remove_armed && "border-border text-muted"
                    ]}
                    phx-click="arm-remove"
                    aria-pressed={@remove_armed}
                  >{Web.I18n.t("room.removeMode", @locale)}</button>
                  <button
                    type="button"
                    class="rounded border border-border px-2 py-1.5 text-xs text-muted hover:bg-panel-hover"
                    phx-click="flip-side-to-move"
                  >{side_name((@draft_position || @position).side_to_move, @locale)}</button>
                </div>

                <p class="mb-1 mt-2 text-[.68rem] font-semibold uppercase tracking-wider text-muted">
                  {Web.I18n.t("room.castlingRights", @locale)}
                </p>

                <div class="grid gap-1 text-xs">
                  <%= for right <- @castling_rights do %>
                    <% atom = String.to_existing_atom(right) %>
                    <button
                      type="button"
                      class="flex items-center gap-2 text-left text-muted hover:text-foreground"
                      phx-click="set-castling-right"
                      phx-value-right={right}
                      aria-pressed={
                        MapSet.member?((@draft_position || @position).castling_rights, atom)
                      }
                    >
                      <span class={
                        if MapSet.member?((@draft_position || @position).castling_rights, atom),
                          do: "text-success",
                          else: "text-faint"
                      }>{if MapSet.member?((@draft_position || @position).castling_rights, atom),
                        do: "☑",
                        else: "☐"}</span> {castling_label(right, @locale)}
                    </button>
                  <% end %>
                </div>

                <form phx-submit="set-en-passant" class="mt-3 flex items-center gap-2">
                  <label for="en-passant" class="text-xs text-muted">{Web.I18n.t(
                    "room.enPassantLabel",
                    @locale
                  )}</label>
                  <input
                    id="en-passant"
                    name="square"
                    placeholder={Web.I18n.t("room.enPassantPlaceholder", @locale)}
                    value={
                      if (@draft_position || @position).en_passant,
                        do: Chess.Square.to_algebraic((@draft_position || @position).en_passant),
                        else: ""
                    }
                    class="min-w-0 flex-1 rounded border border-border px-2 py-1 text-xs"
                  />
                </form>
              </aside>
            </div>

            <div
              :if={@position}
              class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 max-[860px]:flex max-[860px]:flex-wrap max-[860px]:justify-center"
            >
              <div class="flex min-w-0 flex-wrap items-center gap-2 text-xs text-muted">
                <span>{Web.I18n.t("room.sideToMove", @locale)}:
                <strong class="text-foreground">{side_name(
                  (@draft_position || @position).side_to_move,
                  @locale
                )}</strong></span>
                <span
                  :if={@insights && @insights.checkmate[@position.side_to_move]}
                  class="rounded-full border border-error bg-error/10 px-2 py-0.5 font-semibold text-error"
                >{Web.I18n.t("room.checkmate", @locale)}</span>
                <span
                  :if={
                    (@insights && not @insights.checkmate[@position.side_to_move]) and
                      @insights.in_check[@position.side_to_move]
                  }
                  class="rounded-full border border-error bg-error/10 px-2 py-0.5 font-semibold text-error"
                >{Web.I18n.t("room.check", @locale)}</span>
              </div>

              <div
                class="flex items-center justify-center gap-1"
                role="group"
                aria-label={Web.I18n.t("room.moveControls", @locale)}
              >
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.firstMove", @locale)}
                  title={Web.I18n.t("room.firstMove", @locale)}
                  disabled={@current_path == []}
                  phx-click="first-move"
                ><.icon name="first" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.previousMove", @locale)}
                  title={Web.I18n.t("room.previousMove", @locale)}
                  disabled={@current_path == []}
                  phx-click="previous-move"
                ><.icon name="previous" class="h-4 w-4" /></button>
                <span class="min-w-16 text-center font-mono text-xs tabular-nums text-muted">{length(
                  @current_path
                )}/{@mainline_length}</span>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.nextMove", @locale)}
                  title={Web.I18n.t("room.nextMove", @locale)}
                  disabled={is_nil(@current_node) or Node.children(@current_node) == []}
                  phx-click="next-move"
                ><.icon name="next" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.lastMove", @locale)}
                  title={Web.I18n.t("room.lastMove", @locale)}
                  disabled={@move_entries == []}
                  phx-click="last-move"
                ><.icon name="last" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm"
                  aria-label={Web.I18n.t("room.flipBoard", @locale)}
                  title={Web.I18n.t("room.flipBoard", @locale)}
                  aria-pressed={@orientation == "black"}
                  phx-click="toggle-orientation"
                ><.icon name="flip" class="h-4 w-4" /></button>
              </div>

              <div class="flex min-w-0 flex-wrap items-center justify-end gap-1 max-[860px]:justify-center">
                <span class="mr-1 text-xs text-muted">{Web.I18n.t(
                  "room.annotationsHeading",
                  @locale
                )}</span>
                <%= for color <- @shape_colors do %>
                  <button
                    type="button"
                    class={[
                      "h-5 w-5 rounded-full border-2",
                      @annotation_color == color && "border-foreground",
                      @annotation_color != color && "border-transparent"
                    ]}
                    style={"background:#{shape_color(color)}"}
                    aria-label={Web.I18n.t("shapeColor." <> color, @locale)}
                    aria-pressed={@annotation_color == color}
                    phx-click="annotation-color"
                    phx-value-color={color}
                  ></button>
                <% end %>

                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-xs text-muted hover:bg-panel-hover"
                  title={Web.I18n.t("room.clearDrawings", @locale)}
                  aria-label={Web.I18n.t("room.clearDrawings", @locale)}
                  phx-click="clear-annotations"
                ><.icon name="eraser" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class={[
                    "rounded border px-2 py-1 text-xs",
                    @position_editor_open && "border-accent-strong bg-accent/20",
                    not @position_editor_open && "border-border"
                  ]}
                  aria-label={Web.I18n.t("room.positionEditor", @locale)}
                  title={Web.I18n.t("room.positionEditor", @locale)}
                  aria-expanded={@position_editor_open}
                  phx-click="toggle-position-editor"
                ><.icon name="sliders" class="h-4 w-4" /></button>
              </div>
            </div>
          </div>

          <section
            :if={@position}
            data-room-strip
            class="overflow-hidden rounded-lg border border-border max-[860px]:relative max-[860px]:overflow-visible"
            aria-label={Web.I18n.t("room.stripHeading", @locale)}
          >
            <div
              class="flex border-b border-border"
              role="tablist"
              aria-label={Web.I18n.t("room.stripHeading", @locale)}
            >
              <button
                type="button"
                class={strip_tab_class(@selected_tab, "material")}
                role="tab"
                aria-selected={@selected_tab == "material"}
                phx-click="select-strip-tab"
                phx-value-tab="material"
              >{Web.I18n.t("room.material", @locale)}<span class="ml-2 text-xs text-faint">{material_balance(
                @insights
              )}</span></button>
              <button
                type="button"
                class={strip_tab_class(@selected_tab, "space")}
                role="tab"
                aria-selected={@selected_tab == "space"}
                phx-click="select-strip-tab"
                phx-value-tab="space"
              >{Web.I18n.t("room.space", @locale)}</button>
              <button
                type="button"
                class={strip_tab_class(@selected_tab, "layers")}
                role="tab"
                aria-selected={@selected_tab == "layers"}
                phx-click="select-strip-tab"
                phx-value-tab="layers"
              >{Web.I18n.t("room.layersTab", @locale)}</button>
              <button
                type="button"
                class="ml-auto inline-flex min-w-9 items-center justify-center px-2 text-muted hover:bg-panel-hover hover:text-foreground max-[860px]:py-[.3rem]"
                aria-expanded={@strip_open}
                aria-label={
                  if @strip_open,
                    do: Web.I18n.t("room.stripCollapse", @locale),
                    else: Web.I18n.t("room.stripExpand", @locale)
                }
                title={
                  if @strip_open,
                    do: Web.I18n.t("room.stripCollapse", @locale),
                    else: Web.I18n.t("room.stripExpand", @locale)
                }
                phx-click="toggle-strip"
              ><.icon name="chevron" up={@strip_open} class="h-4 w-4" /></button>
            </div>

            <div
              :if={@strip_open and @insights}
              data-strip-content
              class="max-h-40 min-h-16 overflow-y-auto p-3 max-[860px]:absolute max-[860px]:bottom-full max-[860px]:left-0 max-[860px]:right-0 max-[860px]:z-30 max-[860px]:border max-[860px]:border-b-0 max-[860px]:bg-panel max-[860px]:shadow-[0_-14px_30px_rgba(0,0,0,.3)]"
            >
              <%= if @selected_tab == "material" do %>
                <div class="grid gap-2 text-xs sm:grid-cols-2">
                  <div
                    :for={color <- [:white, :black]}
                    class="flex items-center justify-between gap-3"
                  >
                    <strong>{side_name(color, @locale)}</strong>
                    <span class="truncate text-muted">{material_text(
                      @insights.material[color],
                      color,
                      @locale
                    )}</span>
                    <span class="font-mono tabular-nums">{material_total(
                      @insights.material[color]
                    )}</span>
                  </div>
                </div>
              <% else %>
                <%= if @selected_tab == "space" do %>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div :for={color <- [:white, :black]}>
                      <div class="mb-1 flex justify-between text-xs">
                        <span>{side_name(color, @locale)}</span><span class="text-muted">{@insights.space[
                          color
                        ].controlled}</span>
                      </div>

                      <div class="h-1.5 overflow-hidden rounded bg-panel-hover">
                        <div
                          class="h-full bg-accent-strong"
                          style={"width:#{min(100, div(@insights.space[color].controlled * 100, 32))}%"}
                        >
                        </div>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-muted">
                    <label
                      :for={layer <- ["files", "attacks", "king_zone", "outposts"]}
                      class="inline-flex items-center gap-1.5"
                    >
                      <input
                        type="checkbox"
                        checked={@layers[String.to_existing_atom(layer)]}
                        phx-click="toggle-layer"
                        phx-value-layer={layer}
                      /> {Web.I18n.t(layer_label_key(layer), @locale)}
                    </label>
                  </div>
                <% end %>
              <% end %>
            </div>

            <p
              :if={@strip_open and is_nil(@insights)}
              data-strip-content
              class="m-0 p-3 text-xs text-muted max-[860px]:absolute max-[860px]:bottom-full max-[860px]:left-0 max-[860px]:right-0 max-[860px]:z-30 max-[860px]:border max-[860px]:border-b-0 max-[860px]:bg-panel max-[860px]:shadow-[0_-14px_30px_rgba(0,0,0,.3)]"
            >
              {Web.I18n.t("room.noInsights", @locale)}
            </p>
          </section>
        </section>

        <aside
          data-mobile-panel="moves"
          class="flex min-h-0 min-w-0 flex-col overflow-hidden border-l border-border max-[860px]:order-6 max-[860px]:border-l-0"
          aria-label={Web.I18n.t("room.panelHeading", @locale)}
          data-tour="moves"
        >
          <header class="flex min-h-10 items-center justify-between gap-2 border-b border-border px-3">
            <h2 class="m-0 text-xs font-semibold uppercase tracking-widest text-muted">
              {Web.I18n.t("room.movesTab", @locale)}
            </h2>

            <details class="relative">
              <summary class="cursor-pointer list-none rounded border border-border px-2 py-1 text-xs hover:bg-panel-hover">
                {Web.I18n.t("room.share", @locale)}
              </summary>

              <div class="absolute right-0 top-full z-20 mt-1 flex min-w-44 flex-col rounded-lg border border-border bg-panel p-1 shadow-xl">
                <button
                  type="button"
                  class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                  phx-click="copy-pgn"
                >{Web.I18n.t("room.copyPgn", @locale)}</button>
                <button
                  type="button"
                  class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                  phx-click="copy-fen"
                >{Web.I18n.t("room.copyFen", @locale)}</button>
                <button
                  type="button"
                  class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                  phx-click="export-image"
                >{Web.I18n.t("room.exportImage", @locale)}</button>
                <button
                  type="button"
                  class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                  phx-click="copy-room-link"
                >{Web.I18n.t("room.share", @locale)} · URL</button>
              </div>
            </details>
          </header>

          <div class="flex-1 space-y-3 overflow-y-auto p-3 max-[860px]:overflow-visible">
            <section
              class="relative rounded-lg border border-border bg-panel p-3"
              data-tour="engine"
            >
              <header class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <h3 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
                    {Web.I18n.t(
                      "room.engine",
                      @locale
                    )}
                  </h3>

                  <span class="rounded-full border border-border bg-panel-hover px-2 py-0.5 text-[.65rem] font-semibold text-muted">{Web.I18n.t(
                    "demo.label",
                    @locale
                  )}</span>
                </div>

                <div class="flex shrink-0 items-center gap-1">
                  <button
                    type="button"
                    class="inline-flex h-8 w-8 items-center justify-center rounded border border-border text-muted hover:bg-panel-hover hover:text-foreground"
                    aria-label={Web.I18n.t("room.engineSettings", @locale)}
                    title={Web.I18n.t("room.engineSettings", @locale)}
                    aria-haspopup="true"
                    aria-expanded={if @engine_settings_open, do: "true", else: "false"}
                    phx-click={
                      if @engine_settings_open,
                        do: "close-engine-settings",
                        else: "open-engine-settings"
                    }
                  ><.icon name="settings" class="h-4 w-4" /></button>
                  <button
                    id="engine-toggle"
                    type="button"
                    role="switch"
                    aria-checked={if @engine_on, do: "true", else: "false"}
                    aria-label={Web.I18n.t("room.engineToggle", @locale)}
                    title={Web.I18n.t("room.engineToggle", @locale)}
                    class={[
                      "relative inline-flex h-5 w-9 shrink-0 items-center rounded-full border transition-colors",
                      @engine_on && "border-accent-strong bg-accent",
                      not @engine_on && "border-border-strong bg-panel"
                    ]}
                    phx-click="toggle-engine"
                  >
                    <span
                      aria-hidden="true"
                      class={[
                        "absolute left-0.5 h-3.5 w-3.5 rounded-full transition-transform",
                        @engine_on && "translate-x-4 bg-white",
                        not @engine_on && "bg-muted"
                      ]}
                    ></span>
                  </button>
                </div>
              </header>

              <div
                :if={@engine_settings_open}
                class="absolute right-2 top-11 z-40 flex max-h-[80dvh] w-[17rem] max-w-[calc(100%-1rem)] flex-col gap-2 overflow-auto rounded-lg border border-border bg-panel p-3 shadow-xl"
                role="group"
                aria-label={Web.I18n.t("room.engineSettings", @locale)}
                phx-click-away="close-engine-settings"
              >
                <form
                  id="engine-settings-form"
                  phx-change="update-engine-settings"
                  class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-2 gap-y-1 text-xs"
                >
                  <label for="engine-provider" class="text-muted">{Web.I18n.t(
                    "room.provider",
                    @locale
                  )}</label>
                  <select
                    id="engine-provider"
                    name="provider"
                    disabled
                    aria-describedby="engine-settings-note"
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  >
                    <option value="demo" selected>
                      {Web.I18n.t("demo.engineProvider", @locale)}
                    </option>

                    <option value="stockfish-wasm" disabled>
                      {Web.I18n.t(
                        "room.providerStockfish",
                        @locale
                      )}
                    </option>

                    <option value="server" disabled>
                      {Web.I18n.t("room.providerServer", @locale)}
                    </option>
                  </select>

                  <label for="engine-depth" class="text-muted">{Web.I18n.t(
                    "room.depth",
                    @locale
                  )}</label>
                  <input
                    id="engine-depth"
                    type="number"
                    name="depth"
                    min="1"
                    max="40"
                    value={@engine_settings.depth}
                    disabled={@engine_on}
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  />
                  <label for="engine-movetime" class="text-muted">{Web.I18n.t(
                    "room.movetime",
                    @locale
                  )}</label>
                  <input
                    id="engine-movetime"
                    type="number"
                    name="movetime_ms"
                    min="100"
                    step="100"
                    value={@engine_settings.movetime_ms}
                    disabled={@engine_on}
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  />
                  <label for="engine-multipv" class="text-muted">{Web.I18n.t(
                    "room.multipv",
                    @locale
                  )}</label>
                  <input
                    id="engine-multipv"
                    type="number"
                    name="multipv"
                    min="1"
                    max="10"
                    value={@engine_settings.multipv}
                    disabled={@engine_on}
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  />
                </form>

                <p id="engine-settings-note" class="m-0 text-[.68rem] text-muted">
                  {Web.I18n.t("demo.engineSettingsNote", @locale)}
                </p>

                <p class="m-0 break-all rounded bg-canvas p-2 text-[.68rem] text-muted">
                  <span class="font-semibold">{Web.I18n.t("room.fen", @locale)}</span>
                  <code class="text-foreground">
                    {if @position,
                      do: to_fen(@position),
                      else: Web.I18n.t("room.noPositionSelected", @locale)}
                  </code>
                </p>
              </div>

              <p class="mb-2 mt-2 text-[.68rem] text-muted">
                {Web.I18n.t("demo.engineNote", @locale)}
              </p>

              <%= if @engine_on and @engine_preview do %>
                <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 rounded bg-canvas p-2 text-xs">
                  <span class="text-muted">{Web.I18n.t("room.eval", @locale)}</span>
                  <strong>{eval_label(@engine_preview)}</strong>
                  <span class="text-muted">{Web.I18n.t("room.depth", @locale)}</span>
                  <strong>{@engine_preview.depth}</strong>
                  <span class="text-muted">{Web.I18n.t("room.nodes", @locale)}</span>
                  <strong>{@engine_preview.nodes}</strong>
                  <span class="text-muted">{Web.I18n.t("room.nps", @locale)}</span>
                  <strong>{@engine_preview.nps}</strong>
                </div>

                <h4 class="mb-1 mt-3 text-[.68rem] font-semibold uppercase tracking-wide text-muted">
                  {Web.I18n.t("room.enginePvHeading", @locale)}
                </h4>

                <ol class="m-0 list-decimal space-y-1 pl-5 text-xs text-muted">
                  <li :for={line <- @engine_preview.pv}>{line}</li>
                </ol>
              <% else %>
                <p class="mb-0 mt-2 text-xs text-muted">
                  {Web.I18n.t("room.evalUnavailable", @locale)}
                </p>
              <% end %>
            </section>

            <.move_list
              rows={@move_rows}
              entries={@move_entries}
              current_path={@current_path}
              focus_path={@move_focus_path || []}
              locale={@locale}
              empty_message={Web.I18n.t("room.noMoves", @locale)}
              help_text={Web.I18n.t("room.treeHelp", @locale)}
            />
            <div :if={@current_path != []} class="flex gap-2 border-t border-border pt-3">
              <button
                :if={List.last(@current_path) != 0}
                type="button"
                class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
                phx-click="promote-variation"
              >{Web.I18n.t("room.promoteVariation", @locale)}</button>
              <button
                type="button"
                class="rounded-md border border-error/50 px-3 py-1.5 text-xs text-error hover:bg-error/10"
                phx-click="remove-subtree"
              >{Web.I18n.t("room.removeSubtree", @locale)}</button>
            </div>

            <section class="border-t border-border pt-3">
              <h3 class="mb-2 mt-0 text-xs font-semibold uppercase tracking-wider text-muted">
                {Web.I18n.t("room.comment", @locale)}
              </h3>

              <div
                class="mb-2 flex flex-wrap items-center gap-1"
                aria-label={Web.I18n.t("room.nags", @locale)}
              >
                <span class="mr-1 text-xs text-muted">{Web.I18n.t("room.nags", @locale)}</span>
                <%= for nag <- [1, 2, 3, 4, 5, 6] do %>
                  <button
                    type="button"
                    class={[
                      "rounded border px-2 py-1 text-xs",
                      nag in current_nags(@current_node) && "border-accent-strong bg-accent/20",
                      nag not in current_nags(@current_node) && "border-border"
                    ]}
                    disabled={@current_path == []}
                    title={Web.I18n.t(nag_label_key(nag), @locale)}
                    phx-click="toggle-nag"
                    phx-value-nag={nag}
                  >{nag_glyph(nag)}</button>
                <% end %>
              </div>

              <p :if={@current_path == []} class="text-xs text-muted">
                {Web.I18n.t("room.nagsNeedMove", @locale)}
              </p>

              <form phx-submit="save-comment" class="space-y-2">
                <label class="sr-only" for="analysis-comment">{Web.I18n.t("room.comment", @locale)}</label> <textarea
                  id="analysis-comment"
                  name="comment"
                  rows="3"
                  maxlength="4096"
                  placeholder={Web.I18n.t("room.commentPlaceholder", @locale)}
                  class="w-full resize-y rounded-md border border-border px-3 py-2 text-sm"
                ><%= @current_node && @current_node.comment || "" %></textarea>
                <button
                  type="submit"
                  class="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-panel-hover"
                >{Web.I18n.t("room.saveComment", @locale)}</button>
              </form>
            </section>
          </div>
        </aside>
      <% else %>
        <section class="col-span-full flex min-h-96 items-center justify-center p-6 max-[860px]:order-3 max-[860px]:min-h-64">
          <div class="max-w-lg rounded-xl border border-dashed border-border p-8 text-center">
            <h2 class="mt-0 text-lg font-semibold">{Web.I18n.t("room.startFirst", @locale)}</h2>

            <p class="text-sm text-muted">{Web.I18n.t("room.noAnalyses", @locale)}</p>

            <div class="mt-5 flex flex-wrap justify-center gap-2">
              <button
                type="button"
                class="rounded-lg border border-accent-strong bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-strong"
                phx-click="create-analysis"
              >{Web.I18n.t("room.startFirst", @locale)}</button>
              <button
                type="button"
                class="rounded-lg border border-border px-4 py-2 hover:bg-panel-hover"
                phx-click="open-import"
              >{Web.I18n.t("room.importTitle", @locale)}</button>
            </div>
          </div>
        </section>
      <% end %>
    </section>

    <nav
      id="room-tabs"
      class="hidden shrink-0 items-stretch border-t border-border bg-panel max-[860px]:order-3 max-[860px]:flex"
      aria-label={Web.I18n.t("room.tabsLabel", @locale)}
    >
      <button
        type="button"
        class="flex-1 cursor-pointer border-0 border-t-2 border-transparent bg-transparent px-[.35rem] py-2 text-[.68rem] font-bold uppercase tracking-[.08em] text-muted aria-selected:border-highlight aria-selected:text-foreground"
        data-tab="moves"
        aria-selected="true"
      >{Web.I18n.t(
        "room.movesTab",
        @locale
      )}</button>
      <button
        type="button"
        class="flex-1 cursor-pointer border-0 border-t-2 border-transparent bg-transparent px-[.35rem] py-2 text-[.68rem] font-bold uppercase tracking-[.08em] text-muted aria-selected:border-highlight aria-selected:text-foreground"
        data-tab="games"
        aria-selected="false"
      >{Web.I18n.t(
        "room.analyses",
        @locale
      )}</button>
      <button
        type="button"
        class="flex-1 cursor-pointer border-0 border-t-2 border-transparent bg-transparent px-[.35rem] py-2 text-[.68rem] font-bold uppercase tracking-[.08em] text-muted aria-selected:border-highlight aria-selected:text-foreground"
        data-tab="chat"
        aria-selected="false"
      >{Web.I18n.t(
        "room.chatTab",
        @locale
      )}</button>
      <button
        type="button"
        id="room-panel-size"
        class="inline-flex min-w-10 cursor-pointer items-center justify-center border-0 bg-transparent text-[.95rem] text-muted hover:text-foreground"
        aria-label={Web.I18n.t("room.panelSize", @locale)}
        title={Web.I18n.t("room.panelSize", @locale)}
      >&#8645;</button>
    </nav>
  </div>

  <div
    :if={@draft_position}
    data-pending-edit
    role="status"
    aria-live="polite"
    class="fixed inset-x-3 bottom-3 z-40 mx-auto flex max-w-xl flex-wrap items-center justify-between gap-2 rounded-xl border border-warning bg-panel p-3 text-warning shadow-2xl"
  >
    <div class="min-w-0">
      <strong class="text-xs">{Web.I18n.t("room.pendingTitle", @locale)}</strong>
      <p class="mb-0 mt-1 text-[.68rem] text-muted">
        {if @draft_reasons == [],
          do: Web.I18n.t("room.pendingEdited", @locale),
          else: format_reasons(@draft_reasons, @locale)}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        class="rounded border border-accent-strong bg-accent px-2 py-1 text-[.68rem] font-semibold text-white hover:bg-accent-strong"
        phx-click="apply-pending-edit"
      >{Web.I18n.t("room.pendingApply", @locale)}</button>
      <button
        type="button"
        class="rounded border border-border px-2 py-1 text-[.68rem]"
        phx-click="discard-pending-edit"
      >{Web.I18n.t("room.pendingDiscard", @locale)}</button>
    </div>
  </div>

  <div
    :if={@notice}
    class={[
      "fixed bottom-5 right-5 z-50 max-w-md rounded-xl border px-4 py-3 text-sm shadow-xl",
      @notice.level == :error && "border-error bg-panel text-error",
      @notice.level == :info && "border-border bg-panel text-foreground"
    ]}
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-3">
      <span>{@notice.message}</span><button
        type="button"
        class="text-muted hover:text-foreground"
        aria-label={Web.I18n.t("common.close", @locale)}
        phx-click="clear-notice"
      ><.icon name="close" class="h-4 w-4" /></button>
    </div>
  </div>

  <div
    :if={@pending_promotion}
    class="fixed inset-0 z-[70] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="w-full max-w-sm rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="promotion-title"
    >
      <h2 id="promotion-title" class="mt-0 text-lg font-semibold">
        {Web.I18n.t("room.choosePromotion", @locale)}
      </h2>

      <div class="grid grid-cols-4 gap-2">
        <button
          :for={piece <- ["queen", "rook", "bishop", "knight"]}
          type="button"
          class="flex flex-col items-center gap-1 rounded-lg border border-border p-2 text-xs hover:bg-panel-hover"
          phx-click="promote-pawn"
          phx-value-promotion={piece}
        >
          <.piece_icon
            kind={String.to_existing_atom(piece)}
            color={@pending_promotion.side}
            piece_set={@piece_set}
            class="h-12 w-12"
          /> {piece_name(String.to_existing_atom(piece), @pending_promotion.side, @locale)}
        </button>
      </div>

      <button type="button" class="mt-4 text-sm text-muted underline" phx-click="close-promotion">{Web.I18n.t(
        "common.cancel",
        @locale
      )}</button>
    </section>
  </div>

  <div
    :if={@ui_modal == "import"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="h-[min(35rem,calc(100dvh-2rem))] max-h-[90dvh] w-full max-w-4xl overflow-y-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="import-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="import-title" class="m-0 text-xl font-semibold">
          {Web.I18n.t("room.importTitle", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div
        class="mb-4 flex flex-wrap gap-1 border-b border-border pb-2"
        role="tablist"
        aria-label={Web.I18n.t("room.importTitle", @locale)}
      >
        <button
          :for={
            {source, key} <- [
              {"paste", "room.importTabPaste"},
              {"library", "room.libraryTab"},
              {"lichess", "room.importTabLichess"},
              {"chesscom", "room.importTabChessCom"}
            ]
          }
          type="button"
          class={[
            "rounded-md px-3 py-1.5 text-sm",
            @import_source == source && "bg-accent/20 text-foreground",
            @import_source != source && "text-muted hover:bg-panel-hover"
          ]}
          aria-pressed={@import_source == source}
          phx-click="set-import-source"
          phx-value-source={source}
        >{Web.I18n.t(key, @locale)}</button>
      </div>

      <p class="rounded-md border border-border bg-panel-hover p-2 text-xs text-muted">
        {Web.I18n.t("demo.importNote", @locale)}
      </p>

      <%= if @import_source == "paste" do %>
        <form
          id="pgn-import-form"
          phx-change="validate-pgn-upload"
          phx-submit="import-pgn"
          class="space-y-3"
        >
          <label for="pgn-input" class="block text-sm font-medium">{Web.I18n.t(
            "room.importPgnLabel",
            @locale
          )}</label> <textarea
            id="pgn-input"
            name="pgn_text"
            rows="12"
            maxlength="100000"
            placeholder={Web.I18n.t("room.importPgnPlaceholder", @locale)}
            class="w-full rounded-lg border border-border bg-canvas p-3 font-mono text-sm"
          ><%= @pgn %></textarea>
          <div
            phx-drop-target={@uploads.pgn.ref}
            class="rounded-lg border border-dashed border-border-strong p-3 text-sm text-muted"
          >
            <span>{Web.I18n.t("room.importDropFile", @locale)}</span>
            <.live_file_input upload={@uploads.pgn} class="max-w-full text-xs text-foreground" />
            <ul class="mt-2 space-y-2 p-0">
              <li :for={entry <- @uploads.pgn.entries} class="flex items-center gap-2">
                <span class="min-w-0 flex-1 truncate">{entry.client_name}</span>
                <div class="h-1.5 w-24 overflow-hidden rounded bg-panel-hover">
                  <div class="h-full bg-accent-strong" style={"width:#{entry.progress}%"}></div>
                </div>

                <button
                  type="button"
                  class="text-xs text-muted hover:text-error"
                  aria-label={Web.I18n.t("common.cancel", @locale)}
                  phx-click="cancel-pgn-upload"
                  phx-value-ref={entry.ref}
                ><.icon name="close" class="h-4 w-4" /></button>
              </li>
            </ul>

            <p
              :for={error <- upload_errors(@uploads.pgn)}
              role="alert"
              class="mb-0 mt-2 text-xs text-error"
            >
              {upload_error_message(error, @locale)}
            </p>
          </div>

          <div class="flex flex-wrap justify-between gap-2">
            <button
              type="button"
              class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
              phx-click="use-sample-pgn"
            >{Web.I18n.t("room.importUseSample", @locale)}</button>
            <button
              type="button"
              class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
              phx-click="save-pgn-to-library"
            >{Web.I18n.t("room.saveToLibrary", @locale)}</button>
            <button
              type="submit"
              class="rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
            >{Web.I18n.t("room.importAction", @locale)}</button>
          </div>
        </form>
      <% else %>
        <%= if @import_source == "library" do %>
          <p class="text-sm text-muted">{Web.I18n.t("demo.libraryNote", @locale)}</p>

          <p :if={@library_games == []} class="text-sm text-muted">
            {Web.I18n.t("room.libraryEmpty", @locale)}
          </p>

          <ul class="divide-y divide-border rounded-lg border border-border p-0">
            <li
              :for={game <- @library_games}
              class="flex flex-wrap items-center justify-between gap-3 p-3"
            >
              <div>
                <strong>{game.white} – {game.black}</strong><p class="mb-0 mt-1 text-xs text-muted">
                  {game.opening} · {game.date} · {game.ply_count} plies
                </p>
              </div>

              <div class="flex gap-2">
                <button
                  type="button"
                  class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
                  phx-click="open-demo-game"
                  phx-value-id={game.id}
                >{Web.I18n.t("room.searchOpenInRoom", @locale)}</button>
                <button
                  :if={String.starts_with?(game.id, "local-")}
                  type="button"
                  class="rounded-md border border-border px-3 py-1.5 text-xs text-muted hover:bg-panel-hover"
                  aria-label={Web.I18n.t("room.libraryRemove", @locale)}
                  phx-click="remove-library-game"
                  phx-value-id={game.id}
                ><.icon name="close" class="h-4 w-4" /></button>
              </div>
            </li>
          </ul>
        <% else %>
          <form phx-submit="mock-provider-search" class="flex flex-col gap-3">
            <p class="text-sm text-muted">
              {if @import_source == "lichess",
                do: Web.I18n.t("room.importLichessNote", @locale),
                else: Web.I18n.t("room.importChessComNote", @locale)}
            </p>

            <label class="text-sm" for="provider-query">{Web.I18n.t(
              "room.importUserLabel",
              @locale
            )}</label>
            <input
              id="provider-query"
              name="query"
              placeholder={Web.I18n.t("room.importUserPlaceholder", @locale)}
              class="rounded-lg border border-border px-3 py-2"
            /> <input type="hidden" name="provider" value={@import_source} />
            <button
              type="submit"
              class="self-start rounded-md border border-border px-4 py-2 text-sm hover:bg-panel-hover"
            >{Web.I18n.t("demo.showGames", @locale)}</button>
            <div :if={@search_results != []} class="mt-2 space-y-2">
              <button
                :for={game <- @search_results}
                type="button"
                class="flex w-full justify-between gap-4 rounded-lg border border-border p-3 text-left hover:bg-panel-hover"
                phx-click="open-demo-game"
                phx-value-id={game.id}
              >
                <span><strong>{game.white} – {game.black}</strong><span class="block text-xs text-muted">{game.opening}</span></span>
                <span class="rounded-full border border-border bg-panel-hover px-2 py-0.5 text-[.65rem] font-semibold text-muted">{Web.I18n.t(
                  "demo.label",
                  @locale
                )}</span>
              </button>
            </div>
          </form>
        <% end %>
      <% end %>

      <p :if={@import_error} role="alert" class="mt-3 text-sm text-error">{@import_error}</p>
    </section>
  </div>

  <div
    :if={@ui_modal == "search"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-5xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="search-title"
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <h2 id="search-title" class="m-0 text-xl font-semibold">
          {Web.I18n.t("room.importSearchTitle", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <p class="rounded-md border border-border bg-panel-hover p-2 text-xs text-muted">
        {Web.I18n.t("demo.searchNote", @locale)}
      </p>

      <form
        id="search-games-form"
        phx-submit="search-games"
        phx-change="set-search-filter"
        class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
      >
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchPlayerLabel",
          @locale
        )}<input
          name="player"
          value={@search_filters["player"]}
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        /></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchColourLabel",
          @locale
        )}<select
          name="color"
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        ><option value="either" selected={@search_filters["color"] == "either"}>
          {Web.I18n.t("room.searchColourEither", @locale)}
        </option><option value="white" selected={@search_filters["color"] == "white"}>
          {Web.I18n.t("room.searchColourWhite", @locale)}
        </option><option value="black" selected={@search_filters["color"] == "black"}>
          {Web.I18n.t("room.searchColourBlack", @locale)}
        </option></select></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchResultLabel",
          @locale
        )}<select
          name="result"
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        ><option value="either" selected={@search_filters["result"] == "either"}>
          {Web.I18n.t("room.searchResultEither", @locale)}
        </option><option value="1-0" selected={@search_filters["result"] == "1-0"}>
          1-0
        </option><option value="0-1" selected={@search_filters["result"] == "0-1"}>0-1</option><option
          value="1/2-1/2"
          selected={@search_filters["result"] == "1/2-1/2"}
        >
          ½-½
        </option></select></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchOpeningLabel",
          @locale
        )}<input
          name="opening"
          value={@search_filters["opening"]}
          placeholder={Web.I18n.t("room.importSearchOpeningPlaceholder", @locale)}
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        /></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.searchDateFrom",
          @locale
        )}<input
          type="date"
          name="date_from"
          value={@search_filters["date_from"]}
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        /></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.searchDateTo",
          @locale
        )}<input
          type="date"
          name="date_to"
          value={@search_filters["date_to"]}
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        /></label>
        <fieldset class="grid gap-3 rounded-lg border border-border p-3 sm:col-span-2 lg:col-span-4 lg:grid-cols-2">
          <legend class="px-1 text-xs font-semibold text-muted">
            {Web.I18n.t("room.importSearchPositionLabel", @locale)}
          </legend>

          <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
            "room.searchPositionMode",
            @locale
          )}<select
            name="position_mode"
            class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
          ><option value="exact" selected={@search_filters["position_mode"] == "exact"}>
            {Web.I18n.t("room.searchModeExact", @locale)}
          </option><option
            value="colour_swap"
            selected={@search_filters["position_mode"] == "colour_swap"}
          >
            {Web.I18n.t("room.searchModeColourSwap", @locale)}
          </option><option
            value="substitutions"
            selected={@search_filters["position_mode"] == "substitutions"}
          >
            {Web.I18n.t("room.searchModeSubstitutions", @locale)}
          </option></select></label>
          <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
            "room.searchFenLabel",
            @locale
          )}<input
            name="fen"
            value={@search_filters["fen"]}
            placeholder={Web.I18n.t("room.searchFenPlaceholder", @locale)}
            spellcheck="false"
            class="rounded-md border border-border px-2 py-2 font-mono text-xs text-foreground"
          /></label>
          <label
            :if={@search_filters["position_mode"] == "substitutions"}
            class="flex flex-col gap-1 text-xs text-muted"
          >{Web.I18n.t("room.searchSubstitutionsLabel", @locale)}<input
            name="substitutions"
            value={@search_filters["substitutions"]}
            placeholder={Web.I18n.t("room.searchSubstitutionsPlaceholder", @locale)}
            spellcheck="false"
            class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
          /></label>
          <p class="m-0 self-center text-xs text-muted lg:col-span-2">
            {Web.I18n.t("demo.positionSearchNote", @locale)}
          </p>
        </fieldset>

        <button
          type="submit"
          class="rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong sm:col-span-2 lg:col-span-1"
        >{Web.I18n.t("room.importSearchAction", @locale)}</button>
      </form>

      <p class="mt-3 text-xs text-muted">{Web.I18n.t("room.searchIndexNote", @locale)}</p>

      <div class="mt-4">
        <p :if={@search_results == []} class="text-sm text-muted">
          {Web.I18n.t("room.searchNothingFound", @locale)}
        </p>

        <ul
          :if={@search_results != []}
          class="divide-y divide-border rounded-lg border border-border p-0"
        >
          <li
            :for={game <- @search_results}
            class="flex flex-wrap items-center justify-between gap-3 p-3"
          >
            <div>
              <strong class="text-sm">{game.white} – {game.black}</strong><p class="mb-0 mt-1 text-xs text-muted">
                {game.event} · {game.date} · {game.result} · {game.opening} · {game.ply_count} plies
              </p>
            </div>

            <button
              type="button"
              class="rounded-md border border-border px-3 py-2 text-xs hover:bg-panel-hover"
              phx-click="open-demo-game"
              phx-value-id={game.id}
            >{Web.I18n.t("room.searchOpenInRoom", @locale)}</button>
          </li>
        </ul>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "setup"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[92dvh] w-full max-w-4xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="setup-title"
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <div>
          <h2 id="setup-title" class="m-0 text-xl font-semibold">
            {Web.I18n.t("room.setupHeading", @locale)}
          </h2><p class="mb-0 mt-1 text-sm text-muted">
            {Web.I18n.t("room.setupDescription", @locale)}
          </p>
        </div>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_240px]">
        <.chess_board
          board_id="setup-board"
          position={@setup_position}
          locale={@locale}
          orientation={@orientation}
          piece_set={@piece_set}
        />
        <div>
          <p class="mt-0 text-xs text-muted">{Web.I18n.t("room.armHint", @locale)}</p>

          <div
            id="setup-palette"
            phx-hook="PaletteDrag"
            class="mx-auto grid w-full touch-none select-none max-w-[15rem] grid-cols-4 gap-1"
          >
            <%= for {color, kind} <- piece_palette() do %>
              <% code = Atom.to_string(color) <> "_" <> Atom.to_string(kind) %>
              <button
                type="button"
                data-piece-code={code}
                class={[
                  "grid aspect-square place-items-center rounded border border-border bg-board-light text-2xl hover:brightness-95",
                  @setup_armed_piece == code && "ring-2 ring-accent-strong"
                ]}
                aria-label={piece_name(kind, color, @locale)}
                phx-click="setup-arm-piece"
                phx-value-piece={code}
              ><.piece_icon
                kind={kind}
                color={color}
                piece_set={@piece_set}
                class="h-[90%] w-[90%]"
              /></button>
            <% end %>
          </div>

          <div class="mt-2 flex gap-2">
            <button
              type="button"
              class="flex-1 rounded border border-border px-2 py-1.5 text-xs"
              phx-click="setup-arm-piece"
              phx-value-piece="remove"
            >{Web.I18n.t("room.removeMode", @locale)}</button>
            <button
              type="button"
              class="flex-1 rounded border border-border px-2 py-1.5 text-xs"
              phx-click="setup-flip-side"
            >{Web.I18n.t("room.flipSideToMove", @locale, %{
              side: side_name(@setup_position.side_to_move, @locale)
            })}</button>
          </div>

          <button
            type="button"
            class="mt-2 w-full rounded border border-border px-2 py-1.5 text-xs"
            phx-click="setup-clear-board"
          >{Web.I18n.t("room.clearBoard", @locale)}</button>
          <p :if={@setup_error} role="alert" class="mt-3 text-xs text-error">{@setup_error}</p>

          <button
            type="button"
            class="mt-4 w-full rounded-lg border border-accent-strong bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-strong"
            phx-click="create-from-setup"
          >{Web.I18n.t("room.createFromSetup", @locale)}</button>
        </div>
      </div>
    </section>
  </div>
</main>
