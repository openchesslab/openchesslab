<main id="main-content" class="min-h-0 overflow-hidden max-[860px]:overflow-visible">
  <section
    :if={@private_gate}
    class="mx-auto max-w-2xl px-4 py-12 text-center"
    id="private-room-gate"
  >
    <h1 class="text-2xl font-semibold">
      {Web.I18n.t("room.label", @locale)}
      <code class="font-mono text-base text-muted">{@private_gate}</code>
    </h1>

    <p class="mt-3 text-sm text-muted">{Web.I18n.t("room.privateGate", @locale)}</p>
    <p class="mt-2 text-sm text-muted">{Web.I18n.t("room.privateGateHelp", @locale)}</p>
    <p :if={!@current_user} class="mt-4 text-sm text-muted">
      {Web.I18n.t("room.privateGateLogin", @locale)}
    </p>
  </section>

  <section
    :if={is_nil(@room) and is_nil(@private_gate)}
    class="mx-auto max-w-2xl px-4 py-12 text-center"
  >
    <h1 class="text-2xl font-semibold">
      {Web.I18n.t("room.loadFailed", @locale, %{message: @error || "not found"})}
    </h1>

    <.link
      navigate={~p"/"}
      class="mt-5 inline-flex items-center rounded-md border border-border px-4 py-2 text-foreground hover:bg-panel-hover"
    >
      OpenChessLab
    </.link>
  </section>

  <div
    :if={@room}
    id="room-shell"
    class="flex h-[calc(100dvh_-_3.4rem)] min-h-[38rem] flex-col overflow-hidden border-t border-border max-[860px]:h-auto max-[860px]:min-h-0 max-[860px]:overflow-visible"
  >
    <div id="room-bar" class="flex shrink-0 flex-col gap-1 border-b border-border px-3 py-1.5">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h1 class="m-0 whitespace-nowrap text-base font-semibold">
          <span class="text-muted">{Web.I18n.t("room.label", @locale)}</span>
          <code class="ml-1 font-mono text-sm text-foreground">{@room_code}</code>
        </h1>

        <div class="flex items-center gap-1">
          <button
            :if={is_nil(@room.owner_user_id)}
            type="button"
            class="inline-flex min-h-7 min-w-7 items-center justify-center rounded-md border border-border bg-transparent px-1.5 text-foreground hover:bg-panel-hover"
            aria-label={Web.I18n.t("common.copyCode", @locale)}
            title={Web.I18n.t("common.copyCode", @locale)}
            phx-click="copy-room-code"
          >
            <.icon name="copy" class="h-3.5 w-3.5" />
          </button>
          <button
            :if={@current_user && @room.owner_user_id == @current_user.id}
            type="button"
            id="members-button"
            class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-1 text-xs font-semibold hover:bg-panel-hover"
            phx-click="open-members"
          >
            <.icon name="person" class="h-3.5 w-3.5" />
            {Web.I18n.t("room.members", @locale)}
          </button>
        </div>

        <div class="flex flex-nowrap items-center gap-x-2" role="status" aria-live="polite">
          <span class="h-2 w-2 rounded-full bg-success" aria-hidden="true"></span>
          <span class="whitespace-nowrap text-xs text-muted">{Web.I18n.plural(
            "room.participantCount",
            map_size(@participants),
            %{}
          )}</span>
          <ul class="m-0 flex list-none items-center gap-1 p-0">
            <%= for {id, meta} <- @participants do %>
              <% viewing = meta.analysis_id && Enum.find(@analyses, &(&1.id == meta.analysis_id)) %> <% viewer_title =
                if viewing, do: "#{meta.display_name} — #{viewing.label}", else: meta.display_name %>
              <li>
                <button
                  :if={id != @participant_id and viewing}
                  type="button"
                  class="grid h-6 w-6 place-items-center rounded-full border border-border bg-panel-hover text-[.6rem] font-bold text-foreground hover:border-accent-strong"
                  title={viewer_title}
                  aria-label={Web.I18n.t("room.followViewer", @locale) <> ": " <> meta.display_name}
                  phx-click="follow-viewer"
                  phx-value-participant_id={id}
                  phx-value-analysis_id={meta.analysis_id}
                  phx-value-path={Enum.join(meta.path || [], ",")}
                >{initials(meta.display_name)}</button>
                <span
                  :if={id == @participant_id or is_nil(viewing)}
                  class="grid h-6 w-6 place-items-center rounded-full border border-border bg-panel-hover text-[.6rem] font-bold text-muted"
                  title={viewer_title}
                >{initials(meta.display_name)}</span>
              </li>
            <% end %>
          </ul>
        </div>

        <div
          class="flex items-center gap-1 text-xs text-muted"
          title={region_tooltip(@local_region, @room_region, @locale)}
        >
          <span aria-hidden="true">{region_badge(@local_region)}{if @room_region &&
                                                                      @room_region !=
                                                                        @local_region,
                                                                    do:
                                                                      "↔" <>
                                                                        region_badge(@room_region),
                                                                    else: ""}</span>
          <span data-latency class="tabular-nums">— ms</span>
          <span class="sr-only">{region_tooltip(@local_region, @room_region, @locale)}</span>
        </div>

        <div class="ml-auto flex items-center gap-1">
          <button
            type="button"
            id="chat-open"
            class="relative inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-border bg-transparent px-2 text-foreground hover:bg-panel-hover"
            aria-label={Web.I18n.t("room.chatHeading", @locale)}
            title={Web.I18n.t("room.chatHeading", @locale)}
            phx-click="open-chat"
          >
            <.icon name="message" class="h-4 w-4" />
            <span
              :if={@chat_unread > 0}
              id="chat-unread"
              class="absolute -right-1.5 -top-1.5 min-w-4 rounded-full bg-accent-strong px-1 text-center text-[.6rem] font-bold leading-4 text-white"
            >{@chat_unread}</span>
          </button>
        </div>
      </div>

      <p :if={@error} role="alert" class="m-0 text-sm text-error">{@error}</p>

      <div class="flex items-center gap-2">
        <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-muted">
          {Web.I18n.t("room.analyses", @locale)}
          <span class="ml-0.5 rounded-full bg-panel-hover px-1.5 py-0.5 text-xs text-foreground">{length(
            @analyses
          )}</span>
        </span>

        <div
          class="flex min-w-0 flex-1 items-center gap-1.5 overflow-x-auto pb-0.5"
          role="tablist"
          aria-label={Web.I18n.t("room.analyses", @locale)}
          data-tour="analyses"
        >
          <%= for analysis <- @analyses do %>
            <% active = analysis.id == @selected_analysis_id %> <% viewers =
              analysis_viewers(analysis.id, @participants, @participant_id) %> <% tracked =
              analysis.id in @tracked_ids %>
            <div class={[
              "flex shrink-0 items-center overflow-hidden rounded-full border",
              active && "border-highlight/40 bg-highlight/15",
              not active && "border-border bg-transparent hover:bg-panel-hover"
            ]}>
              <button
                type="button"
                id={"analysis-chip-" <> analysis.id}
                class="flex max-w-48 items-center gap-1.5 px-2.5 py-1 text-xs font-medium text-foreground"
                aria-pressed={if active, do: "true", else: "false"}
                aria-current={if active, do: "true", else: nil}
                title={analysis.detail}
                phx-click="select-analysis"
                phx-value-id={analysis.id}
              >
                <span class="truncate">{analysis.label}</span>
                <span
                  :if={viewers > 0}
                  class="shrink-0 rounded-full bg-panel-hover px-1 text-[.6rem] text-muted"
                >{viewers}</span>
              </button>
              <button
                :if={@current_user}
                type="button"
                id={"track-" <> analysis.id}
                class="inline-flex self-stretch items-center px-1.5 text-muted hover:text-highlight"
                aria-pressed={if tracked, do: "true", else: "false"}
                aria-label={
                  Web.I18n.t(if(tracked, do: "room.untrack", else: "room.track"), @locale)
                }
                title={Web.I18n.t(if(tracked, do: "room.untrack", else: "room.track"), @locale)}
                phx-click={if tracked, do: "untrack-analysis", else: "track-analysis"}
                phx-value-id={analysis.id}
              ><.icon
                name="star"
                class={
                  if tracked, do: "h-3.5 w-3.5 fill-current text-highlight", else: "h-3.5 w-3.5"
                }
              /></button>
              <button
                :if={active}
                type="button"
                id={"remove-" <> analysis.id}
                class="inline-flex self-stretch items-center border-l border-border px-1.5 text-muted hover:text-error"
                aria-label={Web.I18n.t("room.removeAnalysis", @locale)}
                title={Web.I18n.t("room.removeAnalysis", @locale)}
                phx-click="request-remove-analysis"
                phx-value-id={analysis.id}
              >×</button>
            </div>
          <% end %>

          <button
            type="button"
            class="inline-flex shrink-0 items-center gap-1 rounded-full border border-dashed border-border px-2.5 py-1 text-xs text-muted hover:bg-panel-hover hover:text-foreground"
            title={Web.I18n.t("room.newAnalysis", @locale)}
            aria-label={Web.I18n.t("room.newAnalysis", @locale)}
            phx-click="create-analysis"
          ><.icon name="add" class="h-3.5 w-3.5" /></button>
          <button
            type="button"
            class="inline-flex shrink-0 items-center gap-1 rounded-full border border-dashed border-border px-2.5 py-1 text-xs text-muted hover:bg-panel-hover hover:text-foreground"
            title={Web.I18n.t("room.importTitle", @locale)}
            aria-label={Web.I18n.t("room.importTitle", @locale)}
            data-tour="import"
            phx-click="open-import"
          ><.icon name="import" class="h-3.5 w-3.5" /></button>
          <button
            type="button"
            class="shrink-0 rounded-full border border-dashed border-border px-2.5 py-1 text-xs text-muted hover:bg-panel-hover hover:text-foreground"
            phx-click="open-setup"
          >{Web.I18n.t("room.setupPosition", @locale)}</button>
        </div>
      </div>

      <p
        :if={@analyses == []}
        class="m-0 text-xs text-muted"
      >
        {Web.I18n.t("room.noAnalyses", @locale)}
      </p>
    </div>

    <div
      :if={@chat_open}
      class="fixed inset-0 z-40 bg-black/20"
      phx-click="close-chat"
    >
    </div>

    <aside
      :if={@chat_open}
      id="chat-drawer"
      class="fixed inset-y-0 right-0 z-50 flex w-80 max-w-[92vw] flex-col gap-2 border-l border-border bg-panel p-3 shadow-2xl max-[860px]:inset-x-0 max-[860px]:top-auto max-[860px]:max-h-[70dvh] max-[860px]:w-auto max-[860px]:rounded-t-xl"
      role="dialog"
      aria-label={Web.I18n.t("room.chatHeading", @locale)}
    >
      <header class="flex items-center justify-between gap-2">
        <h2 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
          {Web.I18n.t("room.chatHeading", @locale)}
        </h2>

        <button
          type="button"
          id="chat-close"
          class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-chat"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div
        id="chat-log"
        phx-hook="ScrollLog"
        phx-update="stream"
        role="log"
        aria-live="polite"
        class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto pr-1"
      >
        <article
          :for={{dom_id, message} <- @streams.chat_messages}
          id={dom_id}
          class={[
            "max-w-[95%] rounded-lg border border-border bg-panel px-2.5 py-2",
            message.author_id == @participant_id && "self-end bg-panel-hover"
          ]}
        >
          <header class="flex items-center justify-between gap-3 text-[.68rem] text-muted">
            <strong class="truncate font-medium">{if message.author_id == @participant_id,
              do: Web.I18n.t("room.chatYou", @locale),
              else: message.author}</strong>
            <time class="shrink-0 tabular-nums">{Web.I18n.format_time(message.at)}</time>
          </header>

          <p class="mb-0 mt-1 whitespace-pre-wrap break-words text-xs text-foreground">
            {message.text}
          </p>

          <p
            :if={chat_context(message, @analyses)}
            class="mb-0 mt-1 truncate text-[.65rem] text-muted"
          >
            {Web.I18n.t("room.chatViewing", @locale, %{label: chat_context(message, @analyses)})}
          </p>
        </article>
      </div>

      <p :if={@chat_messages == []} class="m-0 text-xs text-muted">
        {Web.I18n.t("room.chatEmpty", @locale)}
      </p>

      <form phx-submit="send-chat" class="flex shrink-0 gap-1.5">
        <label class="sr-only" for="chat-message">{Web.I18n.t("room.chatPlaceholder", @locale)}</label>
        <input
          id="chat-message"
          name="message"
          maxlength="2000"
          autocomplete="off"
          autofocus
          placeholder={Web.I18n.t("room.chatPlaceholder", @locale)}
          class="min-w-0 flex-1 rounded-md border border-border px-2.5 py-2 text-xs"
        />
        <button
          type="submit"
          class="rounded-md border border-border bg-transparent px-2.5 text-xs font-medium text-foreground hover:bg-panel-hover"
        >{Web.I18n.t("room.chatSend", @locale)}</button>
      </form>

      <p :if={@chat_error} role="alert" class="m-0 text-xs text-error">{@chat_error}</p>
    </aside>

    <section class="grid min-h-0 min-w-0 flex-1 grid-cols-[minmax(0,1fr)_210px_360px] overflow-hidden max-[1100px]:grid-cols-[minmax(0,1fr)_180px_320px] max-[860px]:contents">
      <%= if @analysis do %>
        <section
          class="grid min-h-0 min-w-0 grid-rows-[minmax(0,1fr)_auto] gap-2 overflow-hidden p-3 max-[860px]:order-2 max-[860px]:flex max-[860px]:flex-none max-[860px]:flex-col max-[860px]:gap-1 max-[860px]:p-1.5"
          aria-label={Web.I18n.t("room.boardHeading", @locale)}
        >
          <div class="flex min-h-0 flex-col gap-2 overflow-y-auto max-[860px]:flex-none max-[860px]:gap-1 max-[860px]:overflow-visible">
            <div
              class="relative flex min-h-0 flex-1 items-center justify-center gap-3 max-[860px]:min-h-0 max-[860px]:flex-wrap"
              data-tour="board"
              data-board-zone
            >
              <div class={
                if @engine_on,
                  do:
                    "flex min-h-0 min-w-0 flex-1 items-center justify-center gap-3 max-[860px]:w-full",
                  else: "contents"
              }>
                <div
                  :if={@engine_on}
                  id="evaluation-bar"
                  class={[
                    "relative h-[min(calc(100dvh_-_20rem),42rem)] w-9 shrink-0 overflow-visible rounded border border-border max-[860px]:h-[min(100vw,32rem)]",
                    is_nil(@engine_preview) && "opacity-60"
                  ]}
                  data-eval-bar
                  phx-hook="EvalBar"
                  role="img"
                  aria-label={
                    Web.I18n.t("room.evaluationBar", @locale) <> " " <> eval_label(@engine_preview)
                  }
                  title={eval_label(@engine_preview)}
                >
                  <div class="absolute inset-0 overflow-hidden rounded bg-[#17191f]">
                    <div
                      class="absolute inset-x-0 bg-white"
                      style={eval_fill_style(@engine_preview, @orientation)}
                    >
                    </div>

                    <div class="absolute inset-x-0 top-1/2 h-px bg-white/75"></div>
                  </div>

                  <span
                    class="absolute left-1/2 z-10 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded border border-border bg-panel px-0.5 py-0.5 text-[.55rem] font-mono font-semibold text-foreground"
                    style={
                      "top:clamp(1rem,#{eval_label_position(@engine_preview, @orientation)}%,calc(100% - 1rem))"
                    }
                  >{eval_label(@engine_preview)}</span>
                </div>

                <%= if @position do %>
                  <.chess_board
                    position={@draft_position || @position}
                    locale={@locale}
                    orientation={@orientation}
                    center={not @engine_on}
                    selected_square={@selected_square}
                    cursor_square={@cursor_square}
                    legal_targets={if @draft_position, do: [], else: @legal_targets}
                    shapes={@board_shapes}
                    annotation_color={@annotation_color}
                    piece_set={@piece_set}
                    highlights={if @draft_position, do: %{}, else: @feature_highlights || %{}}
                    last_from={if @draft_position, do: nil, else: @last_from}
                    last_to={if @draft_position, do: nil, else: @last_to}
                    check_squares={
                      if @draft_position,
                        do: [],
                        else: AnalysisView.checked_king_squares(@position)
                    }
                  />
                <% else %>
                  <p class="text-sm text-muted">
                    {Web.I18n.t("room.positionUnavailable", @locale)}
                  </p>
                <% end %>
              </div>

              <p
                data-arrow-hint
                class="pointer-events-none absolute left-1/2 top-2 z-30 hidden -translate-x-1/2 items-center gap-1 whitespace-nowrap rounded-full border border-highlight bg-panel px-3 py-1 text-xs text-highlight shadow-xl in-data-[board-arrow=armed]:inline-flex"
                role="status"
                aria-live="polite"
              >
                {Web.I18n.t("room.arrowFrom", @locale)} <strong data-arrow-from></strong>
                <span class="max-[860px]:hidden">{Web.I18n.t("room.arrowHint", @locale)}</span>
              </p>

              <aside
                :if={@position_editor_open and not is_nil(@position)}
                class="max-h-full w-60 shrink-0 overflow-y-auto rounded-lg border border-border bg-panel p-3 max-[860px]:fixed max-[860px]:inset-x-0 max-[860px]:bottom-0 max-[860px]:top-[42dvh] max-[860px]:z-40 max-[860px]:max-h-none max-[860px]:w-auto max-[860px]:rounded-b-none max-[860px]:border-x-0 max-[860px]:border-b-0 max-[860px]:shadow-2xl"
                aria-label={Web.I18n.t("room.positionEditor", @locale)}
              >
                <header class="mb-2 flex items-center justify-between gap-2">
                  <h3 class="m-0 text-xs font-semibold uppercase tracking-wider text-muted">
                    {Web.I18n.t("room.positionEditor", @locale)}
                  </h3>

                  <button
                    type="button"
                    class="rounded border border-border px-2 py-1 text-xs hover:bg-panel-hover"
                    aria-label={Web.I18n.t("common.close", @locale)}
                    phx-click="toggle-position-editor"
                  ><.icon name="close" class="h-4 w-4" /></button>
                </header>

                <p class="mb-3 mt-0 text-[.68rem] text-muted">
                  {Web.I18n.t("room.editorHint", @locale)}
                </p>

                <p class="mb-1 mt-0 text-[.68rem] font-semibold uppercase tracking-wider text-muted">
                  {Web.I18n.t("room.toolsHeading", @locale)}
                </p>

                <div
                  id="editor-palette"
                  phx-hook="PaletteDrag"
                  class="mb-3 grid w-full touch-none select-none max-w-[15rem] grid-cols-4 gap-1 max-[860px]:mx-auto"
                >
                  <%= for {color, kind} <- piece_palette() do %>
                    <% code = Atom.to_string(color) <> "_" <> Atom.to_string(kind) %>
                    <button
                      type="button"
                      data-piece-code={code}
                      class={[
                        "grid aspect-square place-items-center rounded border border-border bg-board-light text-2xl hover:brightness-95",
                        @armed_piece == code && "ring-2 ring-accent-strong"
                      ]}
                      aria-label={piece_name(kind, color, @locale)}
                      title={piece_name(kind, color, @locale)}
                      phx-click="arm-piece"
                      phx-value-piece={code}
                    ><.piece_icon
                      kind={kind}
                      color={color}
                      piece_set={@piece_set}
                      class="h-[90%] w-[90%]"
                    /></button>
                  <% end %>
                </div>

                <div class="mb-3 flex gap-1">
                  <button
                    type="button"
                    class={[
                      "flex-1 rounded border px-2 py-1.5 text-xs",
                      @remove_armed && "border-error bg-error/10 text-error",
                      not @remove_armed && "border-border text-muted"
                    ]}
                    phx-click="arm-remove"
                    aria-pressed={@remove_armed}
                  >{Web.I18n.t("room.removeMode", @locale)}</button>
                  <button
                    type="button"
                    class="rounded border border-border px-2 py-1.5 text-xs text-muted hover:bg-panel-hover"
                    phx-click="flip-side-to-move"
                  >{side_name((@draft_position || @position).side_to_move, @locale)}</button>
                </div>

                <p class="mb-1 mt-2 text-[.68rem] font-semibold uppercase tracking-wider text-muted">
                  {Web.I18n.t("room.castlingRights", @locale)}
                </p>

                <div class="grid gap-1 text-xs">
                  <%= for right <- @castling_rights do %>
                    <% atom = String.to_existing_atom(right) %>
                    <button
                      type="button"
                      class="flex items-center gap-2 text-left text-muted hover:text-foreground"
                      phx-click="set-castling-right"
                      phx-value-right={right}
                      aria-pressed={
                        MapSet.member?((@draft_position || @position).castling_rights, atom)
                      }
                    >
                      <span class={
                        if MapSet.member?((@draft_position || @position).castling_rights, atom),
                          do: "text-success",
                          else: "text-faint"
                      }>{if MapSet.member?((@draft_position || @position).castling_rights, atom),
                        do: "☑",
                        else: "☐"}</span> {castling_label(right, @locale)}
                    </button>
                  <% end %>
                </div>

                <form phx-submit="set-en-passant" class="mt-3 flex items-center gap-2">
                  <label for="en-passant" class="text-xs text-muted">{Web.I18n.t(
                    "room.enPassantLabel",
                    @locale
                  )}</label>
                  <input
                    id="en-passant"
                    name="square"
                    placeholder={Web.I18n.t("room.enPassantPlaceholder", @locale)}
                    value={
                      if (@draft_position || @position).en_passant,
                        do: Chess.Square.to_algebraic((@draft_position || @position).en_passant),
                        else: ""
                    }
                    class="min-w-0 flex-1 rounded border border-border px-2 py-1 text-xs"
                  />
                </form>
              </aside>
            </div>

            <div
              :if={@position}
              class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 max-[860px]:flex max-[860px]:flex-wrap max-[860px]:justify-center"
            >
              <div class="flex min-w-0 flex-wrap items-center gap-2 text-xs text-muted">
                <span>{Web.I18n.t("room.sideToMove", @locale)}:
                <strong class="text-foreground">{side_name(
                  (@draft_position || @position).side_to_move,
                  @locale
                )}</strong></span>
                <span
                  :if={@insights && @insights.checkmate[@position.side_to_move]}
                  class="rounded-full border border-error bg-error/10 px-2 py-0.5 font-semibold text-error"
                >{Web.I18n.t("room.checkmate", @locale)}</span>
                <span
                  :if={
                    (@insights && not @insights.checkmate[@position.side_to_move]) and
                      @insights.in_check[@position.side_to_move]
                  }
                  class="rounded-full border border-error bg-error/10 px-2 py-0.5 font-semibold text-error"
                >{Web.I18n.t("room.check", @locale)}</span>
              </div>

              <div
                class="flex items-center justify-center gap-1"
                role="group"
                aria-label={Web.I18n.t("room.moveControls", @locale)}
              >
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.firstMove", @locale)}
                  title={Web.I18n.t("room.firstMove", @locale)}
                  disabled={@current_path == []}
                  phx-click="first-move"
                ><.icon name="first" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.previousMove", @locale)}
                  title={Web.I18n.t("room.previousMove", @locale)}
                  disabled={@current_path == []}
                  phx-click="previous-move"
                ><.icon name="previous" class="h-4 w-4" /></button>
                <span class="min-w-16 text-center font-mono text-xs tabular-nums text-muted">{length(
                  @current_path
                )}/{@mainline_length}</span>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.nextMove", @locale)}
                  title={Web.I18n.t("room.nextMove", @locale)}
                  disabled={is_nil(@current_node) or Node.children(@current_node) == []}
                  phx-click="next-move"
                ><.icon name="next" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm disabled:opacity-40"
                  aria-label={Web.I18n.t("room.lastMove", @locale)}
                  title={Web.I18n.t("room.lastMove", @locale)}
                  disabled={@move_entries == []}
                  phx-click="last-move"
                ><.icon name="last" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-sm"
                  aria-label={Web.I18n.t("room.flipBoard", @locale)}
                  title={Web.I18n.t("room.flipBoard", @locale)}
                  aria-pressed={@orientation == "black"}
                  phx-click="toggle-orientation"
                ><.icon name="flip" class="h-4 w-4" /></button>
              </div>

              <div class="flex min-w-0 flex-wrap items-center justify-end gap-1 max-[860px]:justify-center">
                <span class="mr-1 text-xs text-muted">{Web.I18n.t(
                  "room.annotationsHeading",
                  @locale
                )}</span>
                <%= for color <- @shape_colors do %>
                  <button
                    type="button"
                    class={[
                      "h-5 w-5 rounded-full border-2",
                      @annotation_color == color && "border-foreground",
                      @annotation_color != color && "border-transparent"
                    ]}
                    style={"background:#{shape_color(color)}"}
                    aria-label={Web.I18n.t("shapeColor." <> color, @locale)}
                    aria-pressed={@annotation_color == color}
                    phx-click="annotation-color"
                    phx-value-color={color}
                  ></button>
                <% end %>

                <button
                  type="button"
                  class="rounded border border-border px-2 py-1 text-xs text-muted hover:bg-panel-hover"
                  title={Web.I18n.t("room.clearDrawings", @locale)}
                  aria-label={Web.I18n.t("room.clearDrawings", @locale)}
                  phx-click="clear-annotations"
                ><.icon name="eraser" class="h-4 w-4" /></button>
                <button
                  type="button"
                  class={[
                    "rounded border px-2 py-1 text-xs",
                    @position_editor_open && "border-accent-strong bg-accent/20",
                    not @position_editor_open && "border-border"
                  ]}
                  aria-label={Web.I18n.t("room.positionEditor", @locale)}
                  title={Web.I18n.t("room.positionEditor", @locale)}
                  aria-expanded={@position_editor_open}
                  phx-click="toggle-position-editor"
                ><.icon name="sliders" class="h-4 w-4" /></button>
              </div>
            </div>
          </div>

          <section
            :if={@position}
            data-room-strip
            class="overflow-hidden rounded-lg border border-border max-[860px]:relative max-[860px]:overflow-visible"
            aria-label={Web.I18n.t("room.stripHeading", @locale)}
          >
            <div
              class="flex border-b border-border"
              role="tablist"
              aria-label={Web.I18n.t("room.stripHeading", @locale)}
            >
              <button
                type="button"
                class={tab_class(@selected_tab, "material")}
                role="tab"
                aria-selected={@selected_tab == "material"}
                phx-click="select-strip-tab"
                phx-value-tab="material"
              >{Web.I18n.t("room.material", @locale)}<span class="ml-2 text-xs text-faint">{material_balance(
                @insights
              )}</span></button>
              <button
                type="button"
                class={tab_class(@selected_tab, "space")}
                role="tab"
                aria-selected={@selected_tab == "space"}
                phx-click="select-strip-tab"
                phx-value-tab="space"
              >{Web.I18n.t("room.space", @locale)}</button>
              <button
                type="button"
                class="ml-auto inline-flex min-w-9 items-center justify-center px-2 text-muted hover:bg-panel-hover hover:text-foreground max-[860px]:py-[.3rem]"
                aria-expanded={@strip_open}
                aria-label={
                  if @strip_open,
                    do: Web.I18n.t("room.stripCollapse", @locale),
                    else: Web.I18n.t("room.stripExpand", @locale)
                }
                title={
                  if @strip_open,
                    do: Web.I18n.t("room.stripCollapse", @locale),
                    else: Web.I18n.t("room.stripExpand", @locale)
                }
                phx-click="toggle-strip"
              ><.icon name="chevron" up={@strip_open} class="h-4 w-4" /></button>
            </div>

            <div
              :if={@strip_open and @insights}
              data-strip-content
              class="max-h-40 min-h-16 overflow-y-auto p-3 max-[860px]:absolute max-[860px]:bottom-full max-[860px]:left-0 max-[860px]:right-0 max-[860px]:z-30 max-[860px]:border max-[860px]:border-b-0 max-[860px]:bg-panel max-[860px]:shadow-[0_-14px_30px_rgba(0,0,0,.3)]"
            >
              <%= if @selected_tab == "material" do %>
                <div class="grid gap-2 text-xs sm:grid-cols-2">
                  <div
                    :for={color <- [:white, :black]}
                    class="flex items-center justify-between gap-3"
                  >
                    <strong>{side_name(color, @locale)}</strong>
                    <span class="truncate text-muted">{material_text(
                      @insights.material[color],
                      color,
                      @locale
                    )}</span>
                    <span class="font-mono tabular-nums">{material_total(
                      @insights.material[color]
                    )}</span>
                  </div>
                </div>
              <% else %>
                <%= if @selected_tab == "space" do %>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div :for={color <- [:white, :black]}>
                      <div class="mb-1 flex justify-between text-xs">
                        <span>{side_name(color, @locale)}</span><span class="text-muted">{@insights.space[
                          color
                        ].controlled}</span>
                      </div>

                      <div class="h-1.5 overflow-hidden rounded bg-panel-hover">
                        <div
                          class="h-full bg-accent-strong"
                          style={"width:#{min(100, div(@insights.space[color].controlled * 100, 32))}%"}
                        >
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>

            <p
              :if={@strip_open and is_nil(@insights)}
              data-strip-content
              class="m-0 p-3 text-xs text-muted max-[860px]:absolute max-[860px]:bottom-full max-[860px]:left-0 max-[860px]:right-0 max-[860px]:z-30 max-[860px]:border max-[860px]:border-b-0 max-[860px]:bg-panel max-[860px]:shadow-[0_-14px_30px_rgba(0,0,0,.3)]"
            >
              {Web.I18n.t("room.noInsights", @locale)}
            </p>
          </section>
        </section>

        <aside
          id="engine-panel"
          class="relative flex min-h-0 min-w-0 flex-col overflow-hidden border-l border-border max-[860px]:order-3 max-[860px]:border-l-0"
          aria-label={Web.I18n.t("room.engine", @locale)}
          data-tour="engine"
          phx-hook="EngineAnalysis"
          data-engine-on={to_string(@engine_on)}
          data-fen={if @position, do: to_fen(@position), else: ""}
          data-depth={@engine_settings.depth}
          data-multipv={@engine_settings.multipv}
          data-review-fen={review_fen(assigns)}
          data-review-ply={
            if @engine_review && @engine_review.status == :running,
              do: @engine_review.current,
              else: ""
          }
          data-cached-fen={@engine_cached && @engine_cached.fen}
          data-cached-depth={@engine_cached && @engine_cached.depth}
          data-cached-multipv={@engine_cached && @engine_cached.multipv}
        >
          <header class="flex min-h-10 shrink-0 border-b border-border px-3">
            <div
              class="flex items-stretch gap-1"
              role="tablist"
              aria-label={Web.I18n.t("room.engine", @locale)}
            >
              <button
                type="button"
                id="engine-tab-engine"
                role="tab"
                aria-selected={to_string(@engine_tab == "engine")}
                aria-label={Web.I18n.t("room.engine", @locale)}
                title={Web.I18n.t("room.engine", @locale)}
                phx-click="select-engine-tab"
                phx-value-tab="engine"
                class={tab_class(@engine_tab, "engine")}
              >
                <.icon name="cpu" class="h-3.5 w-3.5" />
              </button>
              <button
                type="button"
                id="engine-tab-features"
                role="tab"
                aria-selected={to_string(@engine_tab == "features")}
                aria-label={Web.I18n.t("room.featuresTab", @locale)}
                title={Web.I18n.t("room.featuresTab", @locale)}
                phx-click="select-engine-tab"
                phx-value-tab="features"
                class={tab_class(@engine_tab, "features")}
              >
                <.icon name="list" class="h-3.5 w-3.5" />
              </button>
            </div>
          </header>

          <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden p-3 max-[860px]:overflow-visible">
            <%= if @engine_tab == "engine" do %>
              <div class="flex shrink-0 items-center justify-end gap-1">
                <button
                  type="button"
                  class="inline-flex h-8 w-8 items-center justify-center rounded border border-border text-muted hover:bg-panel-hover hover:text-foreground"
                  aria-label={Web.I18n.t("room.engineSettings", @locale)}
                  title={Web.I18n.t("room.engineSettings", @locale)}
                  aria-haspopup="true"
                  aria-expanded={if @engine_settings_open, do: "true", else: "false"}
                  phx-click={
                    if @engine_settings_open,
                      do: "close-engine-settings",
                      else: "open-engine-settings"
                  }
                ><.icon name="settings" class="h-4 w-4" /></button>
                <button
                  id="engine-toggle"
                  type="button"
                  role="switch"
                  aria-checked={if @engine_on, do: "true", else: "false"}
                  aria-label={Web.I18n.t("room.engineToggle", @locale)}
                  title={Web.I18n.t("room.engineToggle", @locale)}
                  class={[
                    "relative inline-flex h-5 w-9 shrink-0 items-center rounded-full border transition-colors",
                    @engine_on && "border-accent-strong bg-accent",
                    not @engine_on && "border-border-strong bg-panel"
                  ]}
                  phx-click="toggle-engine"
                >
                  <span
                    aria-hidden="true"
                    class={[
                      "absolute left-0.5 h-3.5 w-3.5 rounded-full transition-transform",
                      @engine_on && "translate-x-4 bg-white",
                      not @engine_on && "bg-muted"
                    ]}
                  ></span>
                </button>
              </div>

              <div
                :if={@engine_settings_open}
                class="absolute right-3 top-[5.5rem] z-40 flex max-h-[80dvh] w-[17rem] max-w-[calc(100%_-_1rem)] flex-col gap-2 overflow-auto rounded-lg border border-border bg-panel p-3 shadow-xl"
                role="group"
                aria-label={Web.I18n.t("room.engineSettings", @locale)}
                phx-click-away="close-engine-settings"
              >
                <form
                  id="engine-settings-form"
                  phx-change="update-engine-settings"
                  phx-debounce="300"
                  class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-2 gap-y-1 text-xs"
                >
                  <span class="text-muted">{Web.I18n.t("room.provider", @locale)}</span>
                  <strong id="engine-provider" class="text-xs font-semibold text-foreground">
                    {Web.I18n.t("room.engineLocal", @locale)}
                  </strong>

                  <label for="engine-depth" class="text-muted">{Web.I18n.t(
                    "room.depth",
                    @locale
                  )}</label>
                  <input
                    id="engine-depth"
                    type="number"
                    name="depth"
                    min="1"
                    max="40"
                    value={@engine_settings.depth}
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  />
                  <label for="engine-multipv" class="text-muted">{Web.I18n.t(
                    "room.multipv",
                    @locale
                  )}</label>
                  <input
                    id="engine-multipv"
                    type="number"
                    name="multipv"
                    min="1"
                    max="10"
                    value={@engine_settings.multipv}
                    class="min-w-0 rounded border border-border px-1.5 py-1 text-xs"
                  />
                </form>

                <p id="engine-settings-note" class="m-0 text-[.68rem] text-muted">
                  {Web.I18n.t("room.engineSettingsNote", @locale)}
                </p>

                <p class="m-0 break-all rounded bg-canvas p-2 text-[.68rem] text-muted">
                  <span class="font-semibold">{Web.I18n.t("room.fen", @locale)}</span>
                  <code class="text-foreground">
                    {if @position,
                      do: to_fen(@position),
                      else: Web.I18n.t("room.noPositionSelected", @locale)}
                  </code>
                </p>
              </div>

              <p class="mb-2 mt-2 text-[.68rem] text-muted">
                {Web.I18n.t("room.engineNote", @locale)}
              </p>

              <%= cond do %>
                <% @engine_error -> %>
                  <p id="engine-error" class="mb-0 mt-2 text-xs text-error" role="alert">
                    {Web.I18n.t(@engine_error, @locale)}
                  </p>
                <% @engine_on and @engine_preview -> %>
                  <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 rounded bg-canvas p-2 text-xs">
                    <span class="text-muted">{Web.I18n.t("room.eval", @locale)}</span>
                    <strong id="engine-eval">{eval_label(@engine_preview)}</strong>
                    <span class="text-muted">{Web.I18n.t("room.depth", @locale)}</span>
                    <strong>{@engine_preview.depth}</strong>
                    <span class="text-muted">{Web.I18n.t("room.nodes", @locale)}</span>
                    <strong>{@engine_preview.nodes}</strong>
                    <span class="text-muted">{Web.I18n.t("room.nps", @locale)}</span>
                    <strong>{@engine_preview.nps}</strong>
                  </div>
                <% @engine_on -> %>
                  <p id="engine-loading" class="mb-0 mt-2 text-xs text-muted" role="status">
                    {Web.I18n.t("room.engineLoading", @locale)}
                  </p>
                <% true -> %>
                  <p class="mb-0 mt-2 text-xs text-muted">
                    {Web.I18n.t("room.evalUnavailable", @locale)}
                  </p>
              <% end %>

              <% graph =
                eval_graph(
                  @engine_evals,
                  @analysis,
                  @mainline_length,
                  @current_path,
                  review_marks(@engine_review)
                ) %>

              <div :if={graph.any} id="engine-graph" class="mt-3">
                <svg
                  viewBox="0 0 300 60"
                  class="h-14 w-full rounded border border-border bg-canvas"
                  role="img"
                  aria-label={Web.I18n.t("room.evaluationGraph", @locale)}
                >
                  <line
                    x1="0"
                    y1="30"
                    x2="300"
                    y2="30"
                    stroke="var(--border)"
                    stroke-width="1"
                  />

                  <polyline
                    :for={points <- graph.groups}
                    points={points}
                    fill="none"
                    stroke="var(--foreground)"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />

                  <circle
                    :for={dot <- graph.dots}
                    cx={dot.x}
                    cy={dot.y}
                    r="2"
                    fill={dot.color}
                  >
                    <title>{dot.label}</title>
                  </circle>

                  <rect
                    :if={@current_path != []}
                    x={graph.current_x - 1.5}
                    y="0"
                    width="3"
                    height="60"
                    fill="var(--accent)"
                    opacity="0.7"
                  />

                  <rect
                    :for={column <- graph.columns}
                    x={column.x}
                    y="0"
                    width={column.w}
                    height="60"
                    fill="transparent"
                    class="cursor-pointer"
                    phx-click="select-path"
                    phx-value-path={column.path}
                  >
                    <title>{column.path}</title>
                  </rect>
                </svg>
              </div>

              <div :if={@mainline_length >= 1} id="engine-review" class="mt-3">
                <%= case @engine_review do %>
                  <% nil -> %>
                    <button
                      id="engine-review-start"
                      type="button"
                      class="rounded-md border border-border px-2 py-1 text-xs hover:bg-panel-hover"
                      title={Web.I18n.t("room.reviewHelp", @locale)}
                      phx-click="engine-review-start"
                    >{Web.I18n.t("room.review", @locale)}</button>
                  <% %{status: :running} = review -> %>
                    <div class="flex items-center justify-between gap-2 rounded bg-canvas p-2 text-xs">
                      <span class="text-muted" role="status">
                        {Web.I18n.t("room.reviewProgress", @locale, %{
                          done: review.done,
                          total: review.total + 1
                        })}
                      </span>
                      <button
                        id="engine-review-cancel"
                        type="button"
                        class="text-muted underline"
                        phx-click="engine-review-cancel"
                      >{Web.I18n.t("common.cancel", @locale)}</button>
                    </div>
                  <% %{status: :done} = review -> %>
                    <div class="rounded bg-canvas p-2 text-xs">
                      <p class="m-0 text-muted">
                        {Web.I18n.t("room.reviewDone", @locale, %{
                          blunders: review.counts.blunders,
                          mistakes: review.counts.mistakes,
                          inaccuracies: review.counts.inaccuracies
                        })}
                      </p>

                      <p
                        :if={
                          review[:accuracy] &&
                            review_accuracy_text(review.accuracy, @locale) != ""
                        }
                        id="review-accuracy"
                        class="m-0 mt-1 font-semibold text-foreground"
                      >
                        {Web.I18n.t("room.reviewAccuracy", @locale)}: {review_accuracy_text(
                          review.accuracy,
                          @locale
                        )}
                      </p>

                      <ul :if={review.marks != %{}} class="m-0 mt-1 list-none space-y-0.5 p-0">
                        <li :for={moment <- review_critical_moments(@move_entries, review)}>
                          <button
                            type="button"
                            class={[
                              "font-mono hover:underline",
                              moment.mark in ["?", "??"] && "text-error",
                              moment.mark == "?!" && "text-warning"
                            ]}
                            phx-click="select-path"
                            phx-value-path={moment.path}
                          >{moment.label} {moment.mark}</button>
                        </li>
                      </ul>

                      <button
                        id="engine-review-again"
                        type="button"
                        class="mt-1 text-muted underline"
                        phx-click="engine-review-start"
                      >{Web.I18n.t("room.reviewAgain", @locale)}</button>
                    </div>
                <% end %>
              </div>

              <div :if={@engine_preview} class="flex min-h-0 flex-1 flex-col">
                <h4 class="mb-1 shrink-0 text-[.68rem] font-semibold uppercase tracking-wide text-muted">
                  {Web.I18n.t("room.enginePvHeading", @locale)}
                </h4>

                <ol class="m-0 min-h-16 flex-1 list-none space-y-1 overflow-y-auto p-0 text-xs leading-relaxed text-muted">
                  <li
                    :for={line <- Enum.take(@engine_preview.pv, @engine_settings.multipv)}
                    class="flex flex-wrap items-baseline gap-x-1"
                  >
                    <strong class="mr-1 font-mono text-foreground">{line.score}</strong>
                    <span
                      :for={{move, index} <- Enum.with_index(Enum.take(line.moves, 8))}
                      class="whitespace-nowrap"
                    >
                      <span :if={move.label} class="text-faint">{move.label}</span>
                      <button
                        type="button"
                        class="rounded px-0.5 hover:bg-panel-hover hover:text-foreground"
                        title={Web.I18n.t("room.enginePlayToHere", @locale)}
                        phx-click="engine-play-pv"
                        phx-value-line={line.multipv}
                        phx-value-ply={index}
                        data-peek-line={line.multipv}
                        data-peek-ply={index}
                      >{move.san}</button>
                    </span>
                    <span :if={length(line.moves) > 8} class="text-faint">…</span>
                  </li>
                </ol>

                <div
                  :if={@engine_peek}
                  id="engine-peek"
                  class="absolute right-3 top-14 z-40 w-44 rounded-lg border border-border bg-panel p-2 shadow-xl"
                  role="tooltip"
                >
                  <div class="grid w-full grid-cols-8 overflow-hidden rounded border border-border">
                    <div
                      :for={square <- peek_squares(@engine_peek.position, @orientation)}
                      class={[
                        "grid aspect-square place-items-center",
                        square.light && "bg-board-light",
                        not square.light && "bg-board-dark"
                      ]}
                    >
                      <.piece_icon
                        :if={square.piece}
                        kind={elem(square.piece, 1)}
                        color={elem(square.piece, 0)}
                        piece_set={@piece_set}
                        class="h-[90%] w-[90%]"
                      />
                    </div>
                  </div>

                  <p class="m-0 mt-1 text-center text-[.68rem] font-semibold text-muted">
                    {@engine_peek.label}
                  </p>
                </div>
              </div>
            <% end %>
            <div :if={@engine_tab == "features"} class="flex min-h-0 flex-1 flex-col gap-2">
              <p
                :if={@features_status == :unreachable}
                id="features-error"
                class="m-0 text-xs text-muted"
              >
                {Web.I18n.t("room.featuresError", @locale)}
              </p>

              <div
                :if={@features}
                id="features-readout"
                class="m-0 min-h-0 flex-1 overflow-y-auto pr-3"
              >
                <section :for={{section, rows} <- @features.sections} class="mb-3 last:mb-0">
                  <h4 class="mb-1 text-[.68rem] font-semibold uppercase tracking-wide text-muted">
                    {Web.I18n.t("room.featuresSection.#{section}", @locale)}
                  </h4>
                  <ul class="m-0 list-none space-y-0.5 p-0">
                    <li :for={{id, label, value, hint} <- rows}>
                      <% drawable = feature_drawable?(value, hint, @position) %>
                      <button
                        type="button"
                        data-feature={id}
                        data-pinned={to_string(MapSet.member?(@pinned_features, id))}
                        data-drawable={to_string(drawable)}
                        class={[
                          "flex w-full flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5 rounded px-1 text-left text-xs hover:bg-panel-hover",
                          MapSet.member?(@pinned_features, id) &&
                            "bg-highlight/15 shadow-[inset_2px_0_0_var(--highlight)]",
                          not MapSet.member?(@pinned_features, id) && @features_detail == id &&
                            "bg-panel-hover",
                          MapSet.member?(@pinned_features, id) && @features_detail == id &&
                            "bg-highlight/25",
                          feature_empty?(value) && "opacity-60"
                        ]}
                        aria-pressed={to_string(@features_detail == id)}
                        phx-click="feature-detail"
                        phx-value-id={id}
                        title={feature_description(id, @locale)}
                      >
                        <span class={[
                          "min-w-0 truncate",
                          MapSet.member?(@pinned_features, id) && "font-semibold text-highlight",
                          not MapSet.member?(@pinned_features, id) && "text-muted"
                        ]}>{label}</span>
                        <span class={[
                          "ml-auto shrink-0 tabular-nums",
                          MapSet.member?(@pinned_features, id) && "font-semibold text-highlight",
                          not MapSet.member?(@pinned_features, id) && "text-foreground"
                        ]}>
                          <span
                            :if={drawable}
                            title={Web.I18n.t("room.featureDrawable", @locale)}
                            class="mr-1 inline-block align-[-2px] text-faint"
                          ><.icon name="board" class="h-3 w-3" /></span>
                          {feature_value(value, @locale)}
                        </span>
                      </button>
                    </li>
                  </ul>
                </section>
              </div>

              <div
                :if={@features_detail && @features}
                id="features-detail"
                class="shrink-0 rounded-lg border border-border bg-canvas p-2"
              >
                <p class="m-0 text-xs font-semibold text-foreground">
                  {feature_label(@features_detail, @locale)}
                </p>
                <p class="m-0 mt-0.5 text-[.68rem] leading-snug text-muted">
                  {feature_description(@features_detail, @locale)}
                </p>
                <p class="m-0 mt-1 font-mono text-[.6rem] text-faint">{@features_detail}</p>
                <pre class="m-0 mt-1 max-h-28 overflow-auto whitespace-pre-wrap break-words rounded bg-panel p-1 text-[.62rem] text-muted">{feature_detail_raw(
                  @features_detail,
                  @features.values
                )}</pre>
              </div>

              <p :if={@features} class="m-0 text-[.68rem] text-faint">
                {Web.I18n.t("room.featuresSource", @locale, %{version: @features.version})}
              </p>
            </div>
          </div>
        </aside>
        <aside
          class="flex min-h-0 min-w-0 flex-col overflow-hidden border-l border-border max-[860px]:order-4 max-[860px]:border-l-0"
          aria-label={Web.I18n.t("room.panelHeading", @locale)}
          data-tour="moves"
        >
          <header class="flex min-h-10 items-center justify-between gap-2 border-b border-border px-3">
            <h2 class="m-0 text-xs font-semibold uppercase tracking-widest text-muted">
              {Web.I18n.t("room.movesTab", @locale)}
            </h2>

            <div class="flex items-center gap-1">
              <button
                type="button"
                id="comment-open"
                class="relative inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
                aria-label={Web.I18n.t("room.comment", @locale)}
                title={Web.I18n.t("room.comment", @locale)}
                phx-click="open-comment-editor"
              >
                <.icon name="edit" class="h-4 w-4" />
                <span
                  :if={comment_present?(@current_node)}
                  class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-highlight"
                ></span>
              </button>

              <details class="relative">
                <summary class="cursor-pointer list-none rounded border border-border px-2 py-1 text-xs hover:bg-panel-hover">
                  {Web.I18n.t("room.share", @locale)}
                </summary>

                <div class="absolute right-0 top-full z-20 mt-1 flex min-w-44 flex-col rounded-lg border border-border bg-panel p-1 shadow-xl">
                  <button
                    type="button"
                    class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                    phx-click="copy-pgn"
                  >{Web.I18n.t("room.copyPgn", @locale)}</button>
                  <button
                    type="button"
                    class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                    phx-click="copy-fen"
                  >{Web.I18n.t("room.copyFen", @locale)}</button>
                  <button
                    type="button"
                    class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                    phx-click="export-image"
                  >{Web.I18n.t("room.exportImage", @locale)}</button>
                  <button
                    type="button"
                    class="rounded px-2 py-1.5 text-left text-xs hover:bg-panel-hover"
                    phx-click="copy-room-link"
                  >{Web.I18n.t("room.share", @locale)} · URL</button>
                </div>
              </details>
            </div>
          </header>

          <div class="flex-1 space-y-3 overflow-y-auto p-3 max-[860px]:overflow-visible">
            <.move_list
              rows={@move_rows}
              entries={@move_entries}
              current_path={@current_path}
              focus_path={@move_focus_path || []}
              locale={@locale}
              empty_message={Web.I18n.t("room.noMoves", @locale)}
              help_text={Web.I18n.t("room.treeHelp", @locale)}
            />
            <div :if={@current_path != []} class="flex gap-2 border-t border-border pt-3">
              <button
                :if={List.last(@current_path) != 0}
                type="button"
                class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
                phx-click="promote-variation"
              >{Web.I18n.t("room.promoteVariation", @locale)}</button>
              <button
                type="button"
                class="rounded-md border border-error/50 px-3 py-1.5 text-xs text-error hover:bg-error/10"
                phx-click="remove-subtree"
              >{Web.I18n.t("room.removeSubtree", @locale)}</button>
            </div>

            <section
              id="reference-panel"
              class="flex max-h-[45%] min-h-0 shrink-0 flex-col gap-2 overflow-hidden border-t border-border pt-3"
              aria-label={Web.I18n.t("room.reference", @locale)}
            >
              <%= case reference_view(@reference) do %>
                <% :none -> %>
                <% :loading -> %>
                  <p class="m-0 text-[.68rem] text-faint">
                    {Web.I18n.t("room.referenceLoading", @locale)}
                  </p>
                <% :failed -> %>
                  <p id="reference-error" class="m-0 text-xs text-muted">
                    {Web.I18n.t("room.referenceError", @locale)}
                  </p>
                <% {:ok, ref} -> %>
                  <%= if ref.endgame do %>
                    <%= case ref.endgame.status do %>
                      <% :ok -> %>
                        <div id="endgame-result" class="flex min-h-0 flex-col gap-2">
                          <p
                            id="endgame-headline"
                            class="m-0 shrink-0 rounded bg-canvas p-2 text-xs"
                          >
                            <strong class="text-foreground">
                              {endgame_headline(ref.endgame.result, @position, @locale)}
                            </strong>
                            <span
                              :if={endgame_distance(ref.endgame.result, @locale)}
                              class="ml-1 font-mono text-faint"
                            >
                              {endgame_distance(ref.endgame.result, @locale)}
                            </span>
                          </p>

                          <ul
                            id="endgame-moves"
                            class="m-0 min-h-0 flex-1 list-none space-y-1 overflow-y-auto p-0"
                          >
                            <li
                              :for={move <- ref.endgame.result["moves"]}
                              class="flex items-center justify-between gap-2 rounded bg-canvas p-2"
                            >
                              <button
                                type="button"
                                class="rounded px-1 font-mono text-sm font-semibold text-foreground hover:bg-panel-hover"
                                title={Web.I18n.t("room.bookPlay", @locale)}
                                phx-click="endgame-play-move"
                                phx-value-uci={move["uci"]}
                              >{move["san"]}</button>
                              <span class="text-xs tabular-nums text-muted">
                                {endgame_chip(move["category"], @locale)}
                              </span>
                            </li>
                          </ul>

                          <p
                            :if={endgame_has_fifty?(ref.endgame.result)}
                            class="m-0 text-[.68rem] text-faint"
                          >
                            {Web.I18n.t("room.endgameFiftyFootnote", @locale)}
                          </p>

                          <p class="m-0 text-[.68rem] text-faint">
                            {Web.I18n.t("room.endgameSource", @locale)}
                          </p>
                        </div>
                      <% :not_in_tablebase -> %>
                        <p id="endgame-unavailable" class="m-0 text-xs text-muted">
                          {Web.I18n.t("room.endgameNotAvailable", @locale)}
                        </p>
                      <% :unreachable -> %>
                        <p id="endgame-error" class="m-0 text-xs text-muted">
                          {Web.I18n.t("room.endgameError", @locale)}
                        </p>
                    <% end %>
                  <% else %>
                    <p
                      :if={ref.opening}
                      id="book-opening"
                      class="m-0 shrink-0 rounded bg-canvas p-2 text-xs text-muted"
                    >
                      <strong class="text-foreground">{ref.opening.name}</strong>
                      <span class="ml-1 font-mono text-faint">{ref.opening.eco}</span>
                    </p>

                    <p :if={ref.moves == []} class="m-0 text-xs text-muted">
                      {Web.I18n.t("room.bookEmpty", @locale)}
                    </p>

                    <ul
                      :if={ref.moves != []}
                      id="book-moves"
                      class="m-0 min-h-0 flex-1 list-none space-y-1 overflow-y-auto p-0"
                    >
                      <li :for={move <- ref.moves} class="rounded bg-canvas p-2">
                        <div class="flex items-center justify-between gap-2">
                          <button
                            type="button"
                            class="rounded px-1 font-mono text-sm font-semibold text-foreground hover:bg-panel-hover"
                            title={Web.I18n.t("room.bookPlay", @locale)}
                            phx-click="book-play-move"
                            phx-value-uci={move.uci}
                          >{move.san}</button>
                          <span class="text-xs tabular-nums text-muted">{move.games}</span>
                        </div>

                        <div
                          class="mt-1 flex h-1.5 w-full overflow-hidden rounded"
                          role="img"
                          aria-label={"#{move.white}/#{move.draws}/#{move.black}"}
                        >
                          <div class="bg-white" style={"width: #{book_share(move.white, move)}%"}>
                          </div>
                          <div class="bg-muted" style={"width: #{book_share(move.draws, move)}%"}>
                          </div>
                          <div
                            class="bg-[#17191f]"
                            style={"width: #{book_share(move.black, move)}%"}
                          >
                          </div>
                        </div>

                        <p :if={move.opening} class="m-0 mt-1 truncate text-[.68rem] text-faint">
                          {move.opening.name} · {move.opening.eco}
                        </p>
                      </li>
                    </ul>
                  <% end %>
              <% end %>
            </section>
          </div>
        </aside>
      <% else %>
        <section class="col-span-full flex min-h-96 items-center justify-center p-6 max-[860px]:order-3 max-[860px]:min-h-64">
          <div class="max-w-lg rounded-xl border border-dashed border-border p-8 text-center">
            <h2 class="mt-0 text-lg font-semibold">{Web.I18n.t("room.startFirst", @locale)}</h2>

            <p class="text-sm text-muted">{Web.I18n.t("room.noAnalyses", @locale)}</p>

            <div class="mt-5 flex flex-wrap justify-center gap-2">
              <button
                type="button"
                class="rounded-lg border border-accent-strong bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-strong"
                phx-click="create-analysis"
              >{Web.I18n.t("room.startFirst", @locale)}</button>
              <button
                type="button"
                class="rounded-lg border border-border px-4 py-2 hover:bg-panel-hover"
                phx-click="open-import"
              >{Web.I18n.t("room.importTitle", @locale)}</button>
            </div>
          </div>
        </section>
      <% end %>
    </section>
  </div>

  <div
    :if={@draft_position}
    data-pending-edit
    role="status"
    aria-live="polite"
    class="fixed inset-x-3 bottom-3 z-40 mx-auto flex max-w-xl flex-wrap items-center justify-between gap-2 rounded-xl border border-warning bg-panel p-3 text-warning shadow-2xl"
  >
    <div class="min-w-0">
      <strong class="text-xs">{Web.I18n.t("room.pendingTitle", @locale)}</strong>
      <p class="mb-0 mt-1 text-[.68rem] text-muted">
        {if @draft_reasons == [],
          do: Web.I18n.t("room.pendingEdited", @locale),
          else: format_reasons(@draft_reasons, @locale)}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        class="rounded border border-accent-strong bg-accent px-2 py-1 text-[.68rem] font-semibold text-white hover:bg-accent-strong"
        phx-click="apply-pending-edit"
      >{Web.I18n.t("room.pendingApply", @locale)}</button>
      <button
        type="button"
        class="rounded border border-border px-2 py-1 text-[.68rem]"
        phx-click="discard-pending-edit"
      >{Web.I18n.t("room.pendingDiscard", @locale)}</button>
    </div>
  </div>

  <div
    :if={@notice}
    class={[
      "fixed bottom-5 right-5 z-50 max-w-md rounded-xl border px-4 py-3 text-sm shadow-xl",
      @notice.level == :error && "border-error bg-panel text-error",
      @notice.level == :info && "border-border bg-panel text-foreground"
    ]}
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-3">
      <span>{@notice.message}</span><button
        type="button"
        class="text-muted hover:text-foreground"
        aria-label={Web.I18n.t("common.close", @locale)}
        phx-click="clear-notice"
      ><.icon name="close" class="h-4 w-4" /></button>
    </div>
  </div>

  <div
    :if={@pending_promotion}
    class="fixed inset-0 z-[70] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="w-full max-w-sm rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="promotion-title"
    >
      <h2 id="promotion-title" class="mt-0 text-lg font-semibold">
        {Web.I18n.t("room.choosePromotion", @locale)}
      </h2>

      <div class="grid grid-cols-4 gap-2">
        <button
          :for={piece <- ["queen", "rook", "bishop", "knight"]}
          type="button"
          class="flex flex-col items-center gap-1 rounded-lg border border-border p-2 text-xs hover:bg-panel-hover"
          phx-click="promote-pawn"
          phx-value-promotion={piece}
        >
          <.piece_icon
            kind={String.to_existing_atom(piece)}
            color={@pending_promotion.side}
            piece_set={@piece_set}
            class="h-12 w-12"
          /> {piece_name(String.to_existing_atom(piece), @pending_promotion.side, @locale)}
        </button>
      </div>

      <button type="button" class="mt-4 text-sm text-muted underline" phx-click="close-promotion">{Web.I18n.t(
        "common.cancel",
        @locale
      )}</button>
    </section>
  </div>

  <div
    :if={@ui_modal == "remove-analysis" and @removal_pending}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="w-full max-w-md rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="remove-analysis-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="remove-analysis-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("room.removeAnalysis", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <p class="mb-4 text-sm text-muted">
        {Web.I18n.t("room.removeAnalysisBody", @locale, %{label: @removal_pending.label})}
      </p>

      <div class="flex justify-end gap-2">
        <button
          type="button"
          class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
          phx-click="close-modal"
        >{Web.I18n.t("common.cancel", @locale)}</button>
        <button
          type="button"
          id="remove-analysis-confirm"
          class="rounded-md border border-error/60 bg-error/20 px-3 py-1.5 text-xs font-semibold text-error hover:bg-error/30"
          phx-click="remove-analysis"
        >{Web.I18n.t("room.removeAnalysisConfirm", @locale)}</button>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "comment"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-lg overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="comment-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="comment-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("room.comment", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div
        class="mb-3 flex flex-wrap items-center gap-1"
        aria-label={Web.I18n.t("room.nags", @locale)}
      >
        <span class="mr-1 text-xs text-muted">{Web.I18n.t("room.nags", @locale)}</span>
        <%= for nag <- [1, 2, 3, 4, 5, 6] do %>
          <button
            type="button"
            class={[
              "rounded border px-2 py-1 text-xs",
              nag in current_nags(@current_node) && "border-accent-strong bg-accent/20",
              nag not in current_nags(@current_node) && "border-border"
            ]}
            disabled={@current_path == []}
            title={Web.I18n.t(nag_label_key(nag), @locale)}
            phx-click="toggle-nag"
            phx-value-nag={nag}
          >{nag_glyph(nag)}</button>
        <% end %>
      </div>

      <p :if={@current_path == []} class="mb-3 text-xs text-muted">
        {Web.I18n.t("room.nagsNeedMove", @locale)}
      </p>

      <form phx-submit="save-comment" class="space-y-3">
        <label class="sr-only" for="analysis-comment">{Web.I18n.t("room.comment", @locale)}</label>
        <textarea
          id="analysis-comment"
          name="comment"
          rows="4"
          maxlength="4096"
          placeholder={Web.I18n.t("room.commentPlaceholder", @locale)}
          class="w-full rounded-md border border-border px-3 py-2 text-sm"
        ><%= @current_node && @current_node.comment || "" %></textarea>

        <div class="flex items-center justify-between gap-2">
          <button
            :if={comment_present?(@current_node)}
            id="comment-clear"
            type="button"
            class="rounded-md border border-error/50 px-3 py-1.5 text-xs text-error hover:bg-error/10"
            phx-click="clear-comment"
          >{Web.I18n.t("room.clearComment", @locale)}</button>

          <div class="ml-auto flex gap-2">
            <button
              type="button"
              class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
              phx-click="close-modal"
            >{Web.I18n.t("common.cancel", @locale)}</button>
            <button
              type="submit"
              id="comment-save"
              class="rounded-md border border-accent-strong bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-strong"
            >{Web.I18n.t("room.saveComment", @locale)}</button>
          </div>
        </div>
      </form>
    </section>
  </div>

  <div
    :if={@ui_modal == "share-confirm"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-lg overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="share-confirm-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="share-confirm-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("room.shareWarnTitle", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <p class="mb-4 text-sm text-muted">{Web.I18n.t("room.shareWarnBody", @locale)}</p>

      <div class="flex flex-col gap-2">
        <button
          id="share-confirm-live"
          type="button"
          class="rounded-md border border-accent-strong bg-accent px-3 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
          phx-click="library-share-confirm"
        >{Web.I18n.t("room.shareWarnConfirm", @locale)}</button>
        <button
          id="share-confirm-copy"
          type="button"
          class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
          phx-click="library-share-copy"
        >{Web.I18n.t("room.shareWarnCopy", @locale)}</button>
        <button
          :if={@share_pending_has_game}
          id="share-confirm-game"
          type="button"
          class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
          phx-click="library-share-game"
        >{Web.I18n.t("room.shareWarnGame", @locale)}</button>
        <button
          id="share-confirm-cancel"
          type="button"
          class="mt-1 text-sm text-muted underline"
          phx-click="close-modal"
        >{Web.I18n.t("library.cancel", @locale)}</button>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "members"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-lg overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="members-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="members-title" class="m-0 text-lg font-semibold">
          {Web.I18n.t("room.members", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border bg-transparent text-foreground hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <p class="mb-4 text-sm text-muted">{Web.I18n.t("room.inviteHelp", @locale)}</p>

      <div :if={@invite_token} class="mb-4 rounded-lg border border-border bg-canvas p-3">
        <p class="mb-2 text-xs text-warning">{Web.I18n.t("room.inviteOnce", @locale)}</p>
        <div class="flex flex-wrap items-center gap-2">
          <input
            id="invite-link"
            type="text"
            readonly
            value={@invite_url}
            class="min-w-0 flex-1 rounded-md border border-border bg-panel px-2 py-1.5 font-mono text-xs"
            aria-label={Web.I18n.t("room.inviteLink", @locale)}
          />
          <button
            type="button"
            class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
            phx-click="copy-invite-link"
          >{Web.I18n.t("common.copyCode", @locale)}</button>
        </div>
      </div>

      <p class="mb-3 text-sm text-muted">
        {Web.I18n.t(
          if(@invite_active, do: "room.inviteActive", else: "room.inviteNone"),
          @locale
        )}
      </p>

      <div class="mb-6 flex flex-wrap gap-2">
        <button
          type="button"
          class="rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
          phx-click="generate-invite"
        >{Web.I18n.t("room.generateInvite", @locale)}</button>
        <button
          :if={@invite_active}
          type="button"
          class="rounded-md border border-border px-4 py-2 text-sm hover:bg-panel-hover"
          phx-click="revoke-invite"
        >{Web.I18n.t("room.revokeInvite", @locale)}</button>
      </div>

      <h3 class="mb-3 text-sm font-semibold">{Web.I18n.t("room.memberList", @locale)}</h3>
      <ul id="room-members" class="m-0 flex list-none flex-col gap-2 p-0">
        <li
          :for={member <- @members}
          id={"member-#{member.user_id}"}
          class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-panel p-3"
        >
          <div class="min-w-0">
            <p class="m-0 text-sm font-semibold">
              {member.display_name}
              <span
                :if={@room.owner_user_id == member.user_id}
                class="ml-1.5 rounded-full bg-panel-hover px-2 py-0.5 text-[.65rem] font-semibold text-muted"
              >{Web.I18n.t("room.owner", @locale)}</span>
            </p>
            <p class="mt-1 text-xs text-muted">
              {Web.I18n.t("room.memberJoined", @locale)}
              <time datetime={NaiveDateTime.to_iso8601(member.joined_at) <> "Z"}>{Calendar.strftime(
                member.joined_at,
                "%Y-%m-%d"
              )}</time>
            </p>
          </div>
          <button
            :if={@room.owner_user_id != member.user_id}
            type="button"
            class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
            phx-click="remove-member"
            phx-value-user_id={member.user_id}
          >{Web.I18n.t("room.removeMember", @locale)}</button>
        </li>
      </ul>
    </section>
  </div>

  <div
    :if={@ui_modal == "import"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="h-[min(35rem,calc(100dvh_-_2rem))] max-h-[90dvh] w-full max-w-4xl overflow-y-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="import-title"
      phx-click-away="close-modal"
    >
      <header class="mb-4 flex items-center justify-between gap-4">
        <h2 id="import-title" class="m-0 text-xl font-semibold">
          {Web.I18n.t("room.importTitle", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div
        class="mb-4 flex flex-wrap gap-1 border-b border-border pb-2"
        role="tablist"
        aria-label={Web.I18n.t("room.importTitle", @locale)}
      >
        <button
          :for={
            {source, key} <- [
              {"paste", "room.importTabPaste"},
              {"library", "room.libraryTab"},
              {"lichess", "room.importTabLichess"},
              {"chesscom", "room.importTabChessCom"}
            ]
          }
          type="button"
          class={[
            "rounded-md px-3 py-1.5 text-sm",
            @import_source == source && "bg-accent/20 text-foreground",
            @import_source != source && "text-muted hover:bg-panel-hover"
          ]}
          aria-pressed={@import_source == source}
          phx-click="set-import-source"
          phx-value-source={source}
        >{Web.I18n.t(key, @locale)}</button>
      </div>

      <%= if @import_source == "paste" do %>
        <form
          id="pgn-import-form"
          phx-change="validate-pgn-upload"
          phx-submit="import-pgn"
          class="space-y-3"
        >
          <label for="pgn-input" class="block text-sm font-medium">{Web.I18n.t(
            "room.importPgnLabel",
            @locale
          )}</label> <textarea
            id="pgn-input"
            name="pgn_text"
            rows="12"
            maxlength="100000"
            placeholder={Web.I18n.t("room.importPgnPlaceholder", @locale)}
            class="w-full rounded-lg border border-border bg-canvas p-3 font-mono text-sm"
          ><%= @pgn %></textarea>
          <div
            phx-drop-target={@uploads.pgn.ref}
            class="rounded-lg border border-dashed border-border-strong p-3 text-sm text-muted"
          >
            <span>{Web.I18n.t("room.importDropFile", @locale)}</span>
            <.live_file_input upload={@uploads.pgn} class="max-w-full text-xs text-foreground" />
            <ul class="mt-2 space-y-2 p-0">
              <li :for={entry <- @uploads.pgn.entries} class="flex items-center gap-2">
                <span class="min-w-0 flex-1 truncate">{entry.client_name}</span>
                <div class="h-1.5 w-24 overflow-hidden rounded bg-panel-hover">
                  <div class="h-full bg-accent-strong" style={"width:#{entry.progress}%"}></div>
                </div>

                <button
                  type="button"
                  class="text-xs text-muted hover:text-error"
                  aria-label={Web.I18n.t("common.cancel", @locale)}
                  phx-click="cancel-pgn-upload"
                  phx-value-ref={entry.ref}
                ><.icon name="close" class="h-4 w-4" /></button>
              </li>
            </ul>

            <p
              :for={error <- upload_errors(@uploads.pgn)}
              role="alert"
              class="mb-0 mt-2 text-xs text-error"
            >
              {upload_error_message(error, @locale)}
            </p>
          </div>

          <div class="flex flex-wrap justify-between gap-2">
            <button
              type="button"
              class="rounded-md border border-border px-3 py-2 text-sm hover:bg-panel-hover"
              phx-click="use-sample-pgn"
            >{Web.I18n.t("room.importUseSample", @locale)}</button>
            <button
              type="submit"
              class="rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong"
            >{Web.I18n.t("room.importAction", @locale)}</button>
          </div>
        </form>
      <% else %>
        <%= if @import_source == "library" do %>
          <p class="text-sm text-muted">{Web.I18n.t("library.description", @locale)}</p>

          <p :if={!@current_user} class="text-sm text-muted">
            {Web.I18n.t("auth.loginRequired", @locale)}
          </p>

          <div :if={@current_user}>
            <p :if={@library_entries == []} id="library-empty" class="text-sm text-muted">
              {Web.I18n.t("library.empty", @locale)}
            </p>

            <ul
              id="library-entries"
              class="m-0 divide-y divide-border rounded-lg border border-border p-0"
            >
              <li
                :for={entry <- @library_entries}
                id={"saved-#{entry.id}"}
                class="flex flex-wrap items-center justify-between gap-3 p-3"
              >
                <div class="min-w-0">
                  <p class="m-0 break-words font-semibold text-foreground">
                    {entry.title || Web.I18n.t("library.untitled", @locale)}
                  </p>
                  <p class="mb-0 mt-1 break-all font-mono text-xs text-faint">{entry.id}</p>
                  <p class="mb-0 mt-1 text-xs text-muted">
                    {Web.I18n.t("library.saved", @locale)}
                    <time datetime={NaiveDateTime.to_iso8601(entry.saved_at) <> "Z"}>{Calendar.strftime(
                      entry.saved_at,
                      "%Y-%m-%d"
                    )}</time>
                  </p>
                </div>

                <div class="flex flex-wrap gap-2">
                  <button
                    :if={entry.game_record_id}
                    type="button"
                    class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
                    title={Web.I18n.t("room.libraryAddGameHelp", @locale)}
                    phx-click="library-add-game"
                    phx-value-id={entry.id}
                  >{Web.I18n.t("room.libraryAddGame", @locale)}</button>
                  <button
                    type="button"
                    class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
                    title={Web.I18n.t("room.libraryAddCopyHelp", @locale)}
                    phx-click="library-add-copy"
                    phx-value-id={entry.id}
                  >{Web.I18n.t("room.libraryAddCopy", @locale)}</button>
                  <button
                    type="button"
                    class="rounded-md border border-accent-strong bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-strong"
                    title={Web.I18n.t("room.libraryShareHelp", @locale)}
                    phx-click="library-share"
                    phx-value-id={entry.id}
                  >{Web.I18n.t("room.libraryShare", @locale)}</button>
                </div>
              </li>
            </ul>

            <nav class="mt-4 flex gap-3" aria-label={Web.I18n.t("library.pages", @locale)}>
              <button
                :if={@library_cursor}
                type="button"
                phx-click="library-first-page"
                class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
              >{Web.I18n.t("library.first", @locale)}</button>
              <button
                :if={@library_next_cursor}
                type="button"
                phx-click="library-next-page"
                class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-panel-hover"
              >{Web.I18n.t("library.next", @locale)}</button>
            </nav>
          </div>
        <% else %>
          <div class="flex flex-col gap-3">
            <p class="m-0 text-sm text-muted">
              {if @import_source == "lichess",
                do: Web.I18n.t("room.importLichessNote", @locale),
                else: Web.I18n.t("room.importChessComNote", @locale)}
            </p>

            <form
              id="provider-load-form"
              phx-submit="load-provider-games"
              class="flex flex-wrap items-end gap-3"
            >
              <label class="flex flex-col gap-1 text-sm" for="provider-username">
                {Web.I18n.t("room.importUserLabel", @locale)}
                <input
                  id="provider-username"
                  name="username"
                  required
                  value={@provider_username}
                  placeholder={Web.I18n.t("room.importUserPlaceholder", @locale)}
                  class="rounded-lg border border-border px-3 py-2"
                />
              </label>

              <label
                :if={@import_source == "chesscom"}
                class="flex flex-col gap-1 text-sm"
                for="provider-month"
              >
                {Web.I18n.t("room.importMonthLabel", @locale)}
                <input
                  id="provider-month"
                  name="month"
                  type="month"
                  value={@chesscom_month}
                  class="rounded-lg border border-border px-3 py-2"
                />
              </label>

              <input type="hidden" name="provider" value={@import_source} />
              <button
                type="submit"
                id="provider-load"
                class="rounded-md border border-border px-4 py-2 text-sm font-semibold hover:bg-panel-hover"
                phx-disable-with={Web.I18n.t("room.importing", @locale)}
              >{Web.I18n.t("room.importLoad", @locale)}</button>
            </form>

            <div :if={@import_games != []} class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="import-games-all"
                  class="rounded-md border border-border px-2 py-1 text-xs hover:bg-panel-hover"
                  phx-click="select-all-import-games"
                >{Web.I18n.t("room.selectAll", @locale)}</button>
                <button
                  type="button"
                  id="import-games-none"
                  class="rounded-md border border-border px-2 py-1 text-xs hover:bg-panel-hover"
                  phx-click="select-no-import-games"
                >{Web.I18n.t("room.selectNone", @locale)}</button>
              </div>

              <ul
                id="import-games-tray"
                class="m-0 max-h-64 divide-y divide-border overflow-y-auto rounded-lg border border-border p-0"
              >
                <li :for={row <- @import_games} class="px-2 py-1.5">
                  <label class="flex cursor-pointer items-baseline gap-2 text-sm">
                    <input
                      type="checkbox"
                      checked={MapSet.member?(@import_selected, row.id)}
                      phx-click="toggle-import-game"
                      phx-value-id={row.id}
                      class="accent-accent-strong"
                    />
                    <span class="min-w-0 flex-1 truncate">{row.white} – {row.black}</span>
                    <span class="shrink-0 text-xs text-faint">{row.result}</span>
                    <span class="shrink-0 text-xs tabular-nums text-faint">
                      {row.speed} · {row.year}
                    </span>
                  </label>
                </li>
              </ul>

              <button
                type="button"
                id="import-selected"
                class="self-start rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong disabled:opacity-50"
                disabled={MapSet.size(@import_selected) == 0}
                phx-click="import-selected-games"
                phx-disable-with={Web.I18n.t("room.importing", @locale)}
              >{Web.I18n.plural("room.importSelectedCount", MapSet.size(@import_selected), %{})}</button>
            </div>
          </div>
        <% end %>
      <% end %>

      <div
        :if={@import_source != "library"}
        id="import-keep"
        class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border pt-3"
      >
        <span class="text-xs font-semibold uppercase tracking-wider text-muted">
          {Web.I18n.t("room.importKeep", @locale)}
        </span>
        <label
          :for={
            {key, label} <- [
              {:comments, "room.keepComments"},
              {:variations, "room.keepVariations"},
              {:metadata, "room.keepMetadata"},
              {:annotations, "room.keepAnnotations"}
            ]
          }
          class="flex cursor-pointer items-center gap-1.5 text-sm text-foreground"
        >
          <input
            type="checkbox"
            id={"import-keep-#{key}"}
            checked={@import_keep[key]}
            phx-click="toggle-import-keep"
            phx-value-key={key}
            class="accent-accent-strong"
          />
          {Web.I18n.t(label, @locale)}
        </label>
      </div>

      <ul
        :if={@import_skips != []}
        id="import-skips"
        class="mt-3 space-y-1 rounded-lg border border-border bg-panel-hover p-3 text-xs text-muted"
      >
        <li :for={skip <- @import_skips}>
          <span class="font-medium text-foreground">{skip.source}</span> — {skip.detail}
        </li>
      </ul>

      <p :if={@import_error} role="alert" class="mt-3 text-sm text-error">{@import_error}</p>
    </section>
  </div>

  <div
    :if={@ui_modal == "search"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[90dvh] w-full max-w-5xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="search-title"
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <h2 id="search-title" class="m-0 text-xl font-semibold">
          {Web.I18n.t("room.importSearchTitle", @locale)}
        </h2>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <p class="rounded-md border border-border bg-panel-hover p-2 text-xs text-muted">
        {Web.I18n.t("room.searchCorpusNote", @locale, %{count: @search_corpus_size || "…"})}
      </p>

      <form
        id="search-games-form"
        phx-submit="search-games"
        phx-change="set-search-filter"
        class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
      >
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchPlayerLabel",
          @locale
        )}<input
          name="player"
          value={@search_filters["player"]}
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        /></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchColourLabel",
          @locale
        )}<select
          name="color"
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        ><option value="either" selected={@search_filters["color"] == "either"}>
          {Web.I18n.t("room.searchColourEither", @locale)}
        </option><option value="white" selected={@search_filters["color"] == "white"}>
          {Web.I18n.t("room.searchColourWhite", @locale)}
        </option><option value="black" selected={@search_filters["color"] == "black"}>
          {Web.I18n.t("room.searchColourBlack", @locale)}
        </option></select></label>
        <label class="flex flex-col gap-1 text-xs text-muted">{Web.I18n.t(
          "room.importSearchResultLabel",
          @locale
        )}<select
          name="result"
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        ><option value="either" selected={@search_filters["result"] == "either"}>
          {Web.I18n.t("room.searchResultEither", @locale)}
        </option><option value="1-0" selected={@search_filters["result"] == "1-0"}>
          1-0
        </option><option value="0-1" selected={@search_filters["result"] == "0-1"}>0-1</option><option
          value="1/2-1/2"
          selected={@search_filters["result"] == "1/2-1/2"}
        >
          ½-½
        </option></select></label>
        <div class="flex flex-col gap-1 text-xs text-muted">
          <span>{Web.I18n.t("room.searchRatingLabel", @locale)}</span>
          <div class="flex gap-1">
            <input
              type="number"
              name="rating_min"
              value={@search_filters["rating_min"]}
              min="0"
              max="4000"
              placeholder={Web.I18n.t("room.searchRatingMin", @locale)}
              class="min-w-0 flex-1 rounded-md border border-border px-2 py-2 text-sm text-foreground"
            />
            <input
              type="number"
              name="rating_max"
              value={@search_filters["rating_max"]}
              min="0"
              max="4000"
              placeholder={Web.I18n.t("room.searchRatingMax", @locale)}
              class="min-w-0 flex-1 rounded-md border border-border px-2 py-2 text-sm text-foreground"
            />
          </div>
        </div>
        <div class="flex flex-col gap-1 text-xs text-muted">
          <span>{Web.I18n.t("room.searchDateLabel", @locale)}</span>
          <div class="flex gap-1">
            <input
              name="date_from"
              value={@search_filters["date_from"]}
              placeholder={Web.I18n.t("room.searchDateFrom", @locale)}
              spellcheck="false"
              class="min-w-0 flex-1 rounded-md border border-border px-2 py-2 font-mono text-xs text-foreground"
            />
            <input
              name="date_to"
              value={@search_filters["date_to"]}
              placeholder={Web.I18n.t("room.searchDateTo", @locale)}
              spellcheck="false"
              class="min-w-0 flex-1 rounded-md border border-border px-2 py-2 font-mono text-xs text-foreground"
            />
          </div>
        </div>
        <div class="flex flex-col gap-1 text-xs text-muted">
          <span>{Web.I18n.t("room.searchFenLabel", @locale)}</span>
          <div class="flex gap-1">
            <input
              name="fen"
              value={@search_filters["fen"]}
              placeholder={Web.I18n.t("room.searchFenPlaceholder", @locale)}
              spellcheck="false"
              class="min-w-0 flex-1 rounded-md border border-border px-2 py-2 font-mono text-xs text-foreground"
            />
            <button
              type="button"
              class="shrink-0 rounded-md border border-border px-2 py-1 text-xs hover:bg-panel-hover"
              title={Web.I18n.t("room.searchUseBoardPosition", @locale)}
              phx-click="search-use-board-fen"
            >⌖</button>
          </div>
        </div>
        <label
          :if={@search_filters["fen"] |> to_string() |> String.trim() != ""}
          class="flex flex-col gap-1 text-xs text-muted"
        >{Web.I18n.t("room.searchPositionMode", @locale)}<select
          name="position_mode"
          class="rounded-md border border-border px-2 py-2 text-sm text-foreground"
        ><option value="exact" selected={@search_filters["position_mode"] == "exact"}>
          {Web.I18n.t("room.searchModeExact", @locale)}
        </option><option
          value="structure"
          selected={@search_filters["position_mode"] == "structure"}
        >
          {Web.I18n.t("room.searchModeStructure", @locale)}
        </option><option
          value="structure_symmetries"
          selected={@search_filters["position_mode"] == "structure_symmetries"}
        >
          {Web.I18n.t("room.searchModeStructureSymmetries", @locale)}
        </option><option
          value="structure_edit1"
          selected={@search_filters["position_mode"] == "structure_edit1"}
        >
          {Web.I18n.t("room.searchModeEdit1", @locale)}
        </option><option
          value="structure_push"
          selected={@search_filters["position_mode"] == "structure_push"}
        >
          {Web.I18n.t("room.searchModePush", @locale)}
        </option><option
          value="structure_missing"
          selected={@search_filters["position_mode"] == "structure_missing"}
        >
          {Web.I18n.t("room.searchModeMissing", @locale)}
        </option><option
          value="structure_color_reversed"
          selected={@search_filters["position_mode"] == "structure_color_reversed"}
        >
          {Web.I18n.t("room.searchModeColorReversed", @locale)}
        </option><option
          value="structure_reflected"
          selected={@search_filters["position_mode"] == "structure_reflected"}
        >
          {Web.I18n.t("room.searchModeReflected", @locale)}
        </option></select></label>

        <button
          type="submit"
          class="rounded-md border border-accent-strong bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-strong sm:col-span-2 lg:col-span-1"
        >{Web.I18n.t("room.importSearchAction", @locale)}</button>
      </form>

      <p :if={@search_error} id="search-error" class="mt-2 text-xs text-error" role="alert">
        {Web.I18n.t(@search_error, @locale)}
      </p>

      <div class="mt-4">
        <p :if={@search_results == []} class="text-sm text-muted">
          {Web.I18n.t("room.searchNothingFound", @locale)}
        </p>

        <ul
          :if={@search_results != []}
          id="corpus-results"
          class="divide-y divide-border rounded-lg border border-border p-0"
        >
          <li
            :for={game <- @search_results}
            id={"corpus-#{game.id}"}
            class="flex flex-wrap items-center justify-between gap-3 p-3"
          >
            <.mini_board :if={game.position} position={game.position} piece_set={@piece_set} />
            <div class="min-w-0 flex-1">
              <strong class="text-sm">{game.white} – {game.black}</strong>
              <p class="mb-0 mt-1 text-xs text-muted">
                {[game.event, game.date, game.result]
                |> Enum.reject(&is_nil/1)
                |> Enum.join(" · ")}
                <span :if={game.ply > 0}>
                  · {Web.I18n.t("room.searchPlyLabel", @locale, %{ply: game.ply})}
                </span>
              </p>
            </div>

            <button
              type="button"
              class="rounded-md border border-border px-3 py-2 text-xs hover:bg-panel-hover"
              phx-click="open-corpus-game"
              phx-value-id={game.id}
            >{Web.I18n.t("room.searchOpenInRoom", @locale)}</button>
          </li>
        </ul>

        <button
          :if={@search_cursor}
          id="search-more"
          type="button"
          class="mt-3 rounded-md border border-border px-3 py-2 text-xs hover:bg-panel-hover"
          phx-click="search-more"
        >{Web.I18n.t("room.searchMore", @locale)}</button>
      </div>
    </section>
  </div>

  <div
    :if={@ui_modal == "setup"}
    class="fixed inset-0 z-[60] grid place-items-center bg-transparent p-4 backdrop-blur-xs backdrop-saturate-[.9]"
  >
    <section
      class="max-h-[92dvh] w-full max-w-4xl overflow-auto rounded-xl border border-border-strong bg-panel p-5 shadow-2xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="setup-title"
      phx-click-away="close-modal"
    >
      <header class="mb-3 flex items-center justify-between gap-4">
        <div>
          <h2 id="setup-title" class="m-0 text-xl font-semibold">
            {Web.I18n.t("room.setupHeading", @locale)}
          </h2><p class="mb-0 mt-1 text-sm text-muted">
            {Web.I18n.t("room.setupDescription", @locale)}
          </p>
        </div>

        <button
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-border hover:bg-panel-hover"
          aria-label={Web.I18n.t("common.close", @locale)}
          phx-click="close-modal"
        ><.icon name="close" class="h-4 w-4" /></button>
      </header>

      <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_240px]">
        <.chess_board
          board_id="setup-board"
          position={@setup_position}
          locale={@locale}
          orientation={@orientation}
          piece_set={@piece_set}
        />
        <div>
          <p class="mt-0 text-xs text-muted">{Web.I18n.t("room.armHint", @locale)}</p>

          <div
            id="setup-palette"
            phx-hook="PaletteDrag"
            class="mx-auto grid w-full touch-none select-none max-w-[15rem] grid-cols-4 gap-1"
          >
            <%= for {color, kind} <- piece_palette() do %>
              <% code = Atom.to_string(color) <> "_" <> Atom.to_string(kind) %>
              <button
                type="button"
                data-piece-code={code}
                class={[
                  "grid aspect-square place-items-center rounded border border-border bg-board-light text-2xl hover:brightness-95",
                  @setup_armed_piece == code && "ring-2 ring-accent-strong"
                ]}
                aria-label={piece_name(kind, color, @locale)}
                phx-click="setup-arm-piece"
                phx-value-piece={code}
              ><.piece_icon
                kind={kind}
                color={color}
                piece_set={@piece_set}
                class="h-[90%] w-[90%]"
              /></button>
            <% end %>
          </div>

          <div class="mt-2 flex gap-2">
            <button
              type="button"
              class="flex-1 rounded border border-border px-2 py-1.5 text-xs"
              phx-click="setup-arm-piece"
              phx-value-piece="remove"
            >{Web.I18n.t("room.removeMode", @locale)}</button>
            <button
              type="button"
              class="flex-1 rounded border border-border px-2 py-1.5 text-xs"
              phx-click="setup-flip-side"
            >{Web.I18n.t("room.flipSideToMove", @locale, %{
              side: side_name(@setup_position.side_to_move, @locale)
            })}</button>
          </div>

          <button
            type="button"
            class="mt-2 w-full rounded border border-border px-2 py-1.5 text-xs"
            phx-click="setup-clear-board"
          >{Web.I18n.t("room.clearBoard", @locale)}</button>
          <p :if={@setup_error} role="alert" class="mt-3 text-xs text-error">{@setup_error}</p>

          <button
            type="button"
            class="mt-4 w-full rounded-lg border border-accent-strong bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-strong"
            phx-click="create-from-setup"
          >{Web.I18n.t("room.createFromSetup", @locale)}</button>
        </div>
      </div>
    </section>
  </div>
</main>
