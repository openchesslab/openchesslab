<main id="main-content" phx-hook="AppUI" class="mx-auto w-full max-w-6xl px-4 py-6">
  <nav class="mb-5 flex items-center justify-between gap-3">
    <.link navigate={~p"/library"} class="text-sm underline">{Web.I18n.t("library.title", @locale)}</.link>
    <.form for={%{}} id="auth-logout" action={~p"/auth/logout"} method="post">
      <button type="submit" class="rounded-md border border-border px-3 py-2 text-sm">{Web.I18n.t(
        "auth.logout",
        @locale
      )}</button>
    </.form>
  </nav>
  <h1 class="text-2xl font-semibold">{Web.I18n.t("personal.title", @locale)}</h1>
  <p class="mb-5 text-sm text-muted">{Web.I18n.t("personal.description", @locale)}</p>
  <p :if={@notice} role="alert" class="mb-3 text-sm">{@notice}</p>
  <div :if={@analysis} class="grid gap-6 min-[861px]:grid-cols-2">
    <section>
      <.chess_board
        position={@position}
        locale={@locale}
        orientation={@orientation}
        selected_square={@selected_square}
        cursor_square={@cursor_square}
        legal_targets={@legal_targets}
        check_squares={AnalysisView.checked_king_squares(@position)}
      />
      <div class="mt-3 flex flex-wrap gap-3">
        <button phx-click="first-move" class="rounded border border-border px-3 py-2">{Web.I18n.t(
          "personal.root",
          @locale
        )}</button>
        <button phx-click="toggle-orientation" class="rounded border border-border px-3 py-2">{Web.I18n.t(
          "room.flipBoard",
          @locale
        )}</button>
      </div>
      <div
        :if={@pending_promotion}
        id="personal-promotion"
        class="mt-3 flex gap-2"
        role="group"
        aria-label={Web.I18n.t("personal.promotion", @locale)}
      >
        <button
          :for={
            {kind, glyph} <- [{"queen", "♕"}, {"rook", "♖"}, {"bishop", "♗"}, {"knight", "♘"}]
          }
          phx-click="promote-pawn"
          phx-value-promotion={kind}
          aria-label={Web.I18n.t("personal." <> kind, @locale)}
          class="rounded border border-border px-3 py-2 text-2xl"
        >{glyph}</button>
      </div>
    </section>
    <section class="min-w-0 rounded-lg border border-border bg-panel p-4">
      <.move_list
        rows={@move_rows}
        entries={@move_entries}
        current_path={@current_path}
        focus_path={@current_path}
        locale={@locale}
        empty_message={Web.I18n.t("personal.noMoves", @locale)}
        help_text={Web.I18n.t("shortcuts.treeRoving", @locale)}
      />
      <div class="my-3 flex flex-wrap gap-2">
        <button
          phx-click="promote-variation"
          disabled={@current_path == []}
          class="rounded border border-border px-3 py-2 disabled:opacity-40"
        >{Web.I18n.t("room.promoteVariation", @locale)}</button>
        <button
          phx-click="remove-subtree"
          disabled={@current_path == []}
          class="rounded border border-border px-3 py-2 disabled:opacity-40"
        >{Web.I18n.t("room.removeSubtree", @locale)}</button>
      </div>
      <div class="mb-3 flex gap-2">
        <button
          :for={{nag, glyph} <- [{1, "!"}, {2, "?"}, {3, "‼"}, {4, "⁇"}, {5, "⁉"}, {6, "⁈"}]}
          phx-click="toggle-nag"
          phx-value-nag={nag}
          aria-pressed={nag in Node.nags(@node)}
          class="rounded border border-border px-3 py-2"
        >{glyph}</button>
      </div>
      <form id="personal-comment" phx-submit="save-comment" class="space-y-2">
        <label for="personal-comment-text" class="block text-sm">{Web.I18n.t(
          "room.comment",
          @locale
        )}</label>
        <textarea
          id="personal-comment-text"
          name="comment"
          class="w-full rounded border border-border bg-panel p-2"
        >{Node.comment(@node) || ""}</textarea>
        <button class="rounded border border-border px-3 py-2">{Web.I18n.t(
          "room.saveComment",
          @locale
        )}</button>
      </form>
    </section>
  </div>
</main>
